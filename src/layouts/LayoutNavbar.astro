---
import { Image } from "astro:assets";
import MenuResponsive from "../components/navbar/menuResponsive.astro";
import ContactButton from "~/components/common/ContactButton.astro";
import CodeAtmosphere from "~/components/common/CodeAtmosphere.astro";
import SeoHead from "~/components/SeoHead.astro";
import Circular from "~/assets/img/CircularPattern.svg";
import { slide, ViewTransitions } from "astro:transitions";

import logoCampus from "~/assets/img/logos/logoCampus_v2.svg";
import facebook from "~/assets/img/icons/Facebook.svg";
import instagram from "~/assets/img/icons/Instagram.svg";
import linkedin from "~/assets/img/icons/LinkedIn.svg";

const {
  dataFooter,
  title,
  description,
  image,
  noindex = false,
  pageType,
  structuredData,
} = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const curryear = new Date().getFullYear();
---

<!doctype html>
<html lang="es-GT" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      pageType={pageType}
      structuredData={structuredData}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="geo.region" content="GT-GUA" />
    <meta name="geo.placename" content="Ciudad de Guatemala, Guatemala" />
    <meta name="google-site-verification" content="VjWljaxyJbf68bXWX6Wna-Zcj84e_y8UWPRUKivFHKw" />
    <ViewTransitions fallback="animate" />
    <script is:inline>
      // Activa el estado visual antes de que el navegador empiece a dibujar
      // las imágenes del body, evitando que el texto alternativo aparezca
      // como contenido roto durante una primera visita.
      document.documentElement.classList.add('enhanced-image-loading');

      const setImageState = (image, state) => {
        image.dataset.imageState = state;
        const shell = image.closest('[data-image-shell]');
        if (shell) shell.dataset.imageState = state;
      };

      const revealImage = (image) => {
        if (image.dataset.imageState === 'loaded') return;
        const finish = () => setImageState(image, 'loaded');
        if (typeof image.decode === 'function') {
          image.decode().catch(() => {}).finally(finish);
        } else {
          finish();
        }
      };

      const prepareImages = (root = document) => {
        root.querySelectorAll('img').forEach((image) => {
          if (image.complete) {
            if (image.naturalWidth > 0) revealImage(image);
            else setImageState(image, 'error');
          } else {
            setImageState(image, 'loading');
          }
        });
      };

      document.addEventListener('load', (event) => {
        if (event.target instanceof HTMLImageElement) revealImage(event.target);
      }, true);
      document.addEventListener('error', (event) => {
        if (event.target instanceof HTMLImageElement) {
          setImageState(event.target, 'error');
        }
      }, true);
      document.addEventListener('DOMContentLoaded', () => prepareImages());
      document.addEventListener('astro:page-load', () => prepareImages());
    </script>
    <!-- Medición diferida para no bloquear el contenido principal -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      let analyticsLoaded = false;
      function loadAnalytics() {
        if (analyticsLoaded) return;
        analyticsLoaded = true;
        const script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-3XTZ0LV0CT';
        document.head.appendChild(script);
        gtag('js', new Date());
        gtag('config', 'G-3XTZ0LV0CT');
      }
      ['pointerdown', 'keydown', 'touchstart'].forEach((eventName) => {
        window.addEventListener(eventName, loadAnalytics, { once: true, passive: true });
      });
      window.setTimeout(loadAnalytics, 12000);
      document.addEventListener('astro:page-load', () => {
        if (!analyticsLoaded) return;
        gtag('event', 'page_view', {
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_title: document.title
        });
      });
    </script>
  </head>
  <body class="relative flex flex-col overflow-x-hidden">
    <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
    <CodeAtmosphere />
    <div
      class="stellar-route-transition"
      data-stellar-route-transition
      transition:persist="stellar-route-transition"
      aria-hidden="true"
    >
      <div class="stellar-route-transition__trajectory">
        <span class="stellar-route-transition__tail"></span>
        <span class="stellar-route-transition__core"></span>
      </div>
      <span class="stellar-route-transition__spark stellar-route-transition__spark--one"></span>
      <span class="stellar-route-transition__spark stellar-route-transition__spark--two"></span>
      <span class="stellar-route-transition__spark stellar-route-transition__spark--three"></span>
      <code class="stellar-route-transition__token stellar-route-transition__token--binary">{`{01}`}</code>
      <code class="stellar-route-transition__token stellar-route-transition__token--tag">&lt;/&gt;</code>
      <code class="stellar-route-transition__token stellar-route-transition__token--commit">commit();</code>
    </div>
    <button
      id="go-up"
      type="button"
      aria-label="Volver al inicio de la página"
      transition:persist="go-up-control"
      class="flex justify-center align-middle bg-primary rounded-full size-10 fixed right-10 bottom-[5%] cursor-pointer z-50"
    >
      <span aria-hidden="true" class="text-white text-xl leading-none">↑</span>
    </button>
    <MenuResponsive>
      <Image
        slot="logo"
        src={logoCampus}
        alt="logoCampus"
        class="py-6 w-[13rem] lg:p-0 lg:w-[15rem]"
        loading="eager"
      />
      <div class="content-redirects items-center hidden md:flex h-full">
        <a
          href="/"
          aria-label="Inicio"
          aria-current={currentPath === "/" ? "page" : undefined}
          class={currentPath === "/"
            ? "active"
            : "text-white hover:text-gray-200"}>Inicio</a
        >
        <a
          href="/joinUs/"
          aria-current={currentPath === "/joinUs" ? "page" : undefined}
          class={currentPath === "/joinUs" ? "active" : ""}
          >Sé un Camper</a
        >
        <a
          href="/emplea/"
          aria-label="Impulsa a tu equipo"
          aria-current={currentPath === "/emplea" ? "page" : undefined}
          class={currentPath === "/emplea"
            ? "active"
            : "text-white hover:text-gray-200"}>Emplea</a
        >
        <a
          href="/patrocina/"
          aria-label="Patrocina nuestros Campers"
          aria-current={currentPath === "/patrocina" ? "page" : undefined}
          class={currentPath === "/patrocina"
            ? "active"
            : "text-white hover:text-gray-200"}>Patrocina</a
        >
        <a
          href="/nosotros/"
          aria-current={currentPath === "/nosotros" ? "page" : undefined}
          class={currentPath === "/nosotros"
            ? "active"
            : "text-white hover:text-gray-200"}>Nosotros</a
        >
        <!-- <a href="#" class={ currentPath === '#' ? 'active' : 'text-white hover:text-gray-200' }>Comunidad</a> -->
      </div>
      <div slot="menuMobile" class="md:hidden">
        <div class="mobile-menu-links flex flex-col items-center gap-y-2 px-5 py-6">
          <a href="/" class="mobile-menu-link">Inicio</a>
          <a href="/joinUs/" class="mobile-menu-link"
            >Sé un Camper</a
          >
          <a href="/emplea/" class="mobile-menu-link">Emplea</a>
          <a href="/patrocina/" class="mobile-menu-link"
            >Patrocina</a
          >
          <a href="/nosotros/" class="mobile-menu-link">Nosotros</a
          >
        </div>
      </div>
    </MenuResponsive>
    <div
      class="site-content-layer relative z-[1] flex flex-col"
      transition:name="page-content"
      transition:animate={slide({ duration: 360 })}
    >
      <main id="contenido-principal" class="flex flex-col gap-[5.5rem]">
        <slot />
      </main>
      <footer class="faq flex flex-col relative">
      <div
        class={`max-w-[1150px] relative sections self-center vstext my-auto flex flex-col gap-y-8 py-20`}
      >
        <p
          class="gradient-text text-lg md:text-[28px] mb-1 font-bold text-center"
        >
          {
            dataFooter
              ? dataFooter.title
              : "¿Preparado para la evolución que tu empresa necesita? Accede al talento que impulsará tu crecimiento y marcará la diferencia."
          }
        </p>
        <p class="text-white font-semibold text-center text-sm md:text-lg">
          {
            dataFooter
              ? dataFooter.content
              : "Estamos listos para ayudarte a formar un equipo que marque la diferencia. Escríbenos y descubre cómo juntos podemos crear el futuro. ¡Da el primer paso hacia un equipo imparable!"
          }
        </p>
        <ContactButton
          tipo={dataFooter ? dataFooter.buttonType : "contacto"}
          linkPage={dataFooter?.buttonLink ?? "https://estudiante-guate.campuslands.com/login"}
          iconName={dataFooter ? dataFooter.buttonIcon : "happyFace.svg"}
          StylesAnchor="self-center"
        />
        <Image
          class="absolute top-[50%] translate-y-[-50%] left-[50%] translate-x-[-50%] -z-50"
          src={Circular}
          alt="imagen-circular"
        />
      </div>
      <div class="flex flex-col gap-y-4 px-14 pb-4">
        <div
          class="flex items-center border-b border-[transparent] md:border-white flex-col md:flex-row justify-between px-6"
        >
          <div class="text-white font-bold mb-7 md:m-0">
            <a href="/">
              <Image
                src={logoCampus}
                alt="logo Campuslands"
                class="py-2 w-[10rem] lg:w-[14rem]"
              />
            </a>
          </div>
          <div
            class="flex flex-col w-full gap-6 md:w-fit md:flex-row md:gap-0 items-center space-x-6"
          >
            <a
              href="/"
              aria-label="Inicio"
              class="text-white hover:text-gray-200 !mx-4">Inicio</a
            >
            <a
              href="/joinUs/"
              aria-label="Sé un Camper"
              class="text-white hover:text-gray-200 !mx-4 break-keep"
              >Sé un Camper</a
            >
            <a href="/emplea/" class="text-white hover:text-gray-200 !mx-4"
              >Emplea</a
            >
            <a
              href="/patrocina/"
              aria-label="Patrocina nuestros Campers"
              class="text-white hover:text-gray-200 !mx-4">Patrocina</a
            >
            <a href="/nosotros/" class="text-white hover:text-gray-200 !mx-4"
              >Nosotros</a
            >
          </div>
        </div>
        <div
          class="flex items-center flex-col-reverse md:flex-row justify-between px-6"
        >
          <div class="flex flex-col items-center gap-2 md:items-start">
            <p class="text-sm font-semibold text-white text-center md:text-start">
              Campuslands Sociedad Anonima
            </p>
            <p class="text-sm font-semibold text-white text-center md:text-start">
              Campuslands Guatemala
            </p>
            <p class="text-xs text-white/80 text-center md:text-start">
              © {curryear} Campuslands Sociedad Anonima - Guatemala. Todos los derechos reservados
            </p>
            <nav
              aria-label="Información legal"
              class="flex flex-col items-center gap-2 md:flex-row md:items-start md:gap-4"
            >
              <a
                href="/terminos-condiciones/"
                class="text-xs text-[#B0F7E6] underline decoration-[#02D9A4]/60 underline-offset-4 transition-colors hover:text-primary"
              >
                Términos y condiciones
              </a>
              <a
                href="/politica-de-privacidad/"
                class="text-xs text-[#B0F7E6] underline decoration-[#02D9A4]/60 underline-offset-4 transition-colors hover:text-primary"
              >
                Política de privacidad y seguridad de datos
              </a>
            </nav>
          </div>
          <div
            class="flex items-center w-full md:w-fit justify-evenly md:gap-x-10"
          >
            <a
              href="https://www.facebook.com/campuslandsgt/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook de Campuslands Guatemala"
              class="w-7 h-7 content-center place-items-center"
              ><Image src={facebook} alt="Logo facebook" /></a
            >
            <a
              href="https://www.instagram.com/campuslands502/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de Campuslands Guatemala"
              class="w-7 h-7 content-center place-items-center"
              ><Image src={instagram} alt="Logo instagram" /></a
            >
            <a
              href="https://www.linkedin.com/company/campuslands-guatemala/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn de Campuslands Guatemala"
              class="w-7 h-7 content-center place-items-center"
              ><Image src={linkedin} alt="Logo linkedin" /></a
            >
          </div>
        </div>
      </div>
      </footer>
    </div>
  </body>
</html>
<script>
  function bindStellarRouteTransition() {
    if (window.__campusStellarRouteTransitionBound) return;
    window.__campusStellarRouteTransitionBound = true;
    let settleTimer = 0;

    const getOverlay = () =>
      document.querySelector<HTMLElement>("[data-stellar-route-transition]");

    document.addEventListener("astro:before-preparation", () => {
      const overlay = getOverlay();
      if (!overlay) return;
      window.clearTimeout(settleTimer);
      overlay.dataset.routePhase = "departing";
    });

    document.addEventListener("astro:after-swap", () => {
      const overlay = getOverlay();
      if (!overlay) return;
      overlay.dataset.routePhase = "arriving";
      settleTimer = window.setTimeout(() => {
        delete overlay.dataset.routePhase;
      }, 440);
    });
  }

  bindStellarRouteTransition();

  function updateActiveLinks() {
    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll(
      ".content-redirects a, .md\\:hidden a"
    );

    navLinks.forEach((link) => {
      const href = link.getAttribute("href");
      if (href === currentPath) {
        link.classList.add("active");
        link.classList.remove("text-white", "hover:text-gray-200");
      } else {
        link.classList.remove("active");
        link.classList.add("text-white", "hover:text-gray-200");
      }
    });
  }

  // Actualizar al cargar la página
  document.addEventListener("DOMContentLoaded", updateActiveLinks);

  // Actualizar cuando cambie la URL (para navegación del lado del cliente)
  document.addEventListener("astro:page-load", updateActiveLinks);

  // Mantener la función goUp existente
  function goUp() {
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.querySelector("#go-up").addEventListener("click", goUp);

  function initializeMeteorCursorTrail() {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-meteor-cursor-trail]",
    );
    const context = canvas?.getContext("2d", {
      alpha: true,
      desynchronized: true,
    });

    if (!canvas || !context) return () => {};

    const trail: Array<{ x: number; y: number; bornAt: number }> = [];
    const sparks: Array<{
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      life: number;
      decay: number;
      aqua: boolean;
    }> = [];
    const clickBursts: Array<{
      x: number;
      y: number;
      bornAt: number;
      rotation: number;
    }> = [];
    const maxSparks = 96;
    const trailDuration = 210;
    const clickBurstDuration = 620;
    let animationFrame = 0;
    let lastX = -100;
    let lastY = -100;
    let lastSparkAt = 0;
    let pixelRatio = 1;

    const resizeCanvas = () => {
      const ratioByPixelBudget = Math.sqrt(
        5_000_000 / Math.max(window.innerWidth * window.innerHeight, 1),
      );
      pixelRatio = Math.max(
        0.75,
        Math.min(window.devicePixelRatio || 1, 1.75, ratioByPixelBudget),
      );
      canvas.width = Math.round(window.innerWidth * pixelRatio);
      canvas.height = Math.round(window.innerHeight * pixelRatio);
      context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
    };

    const drawMeteor = (now: number) => {
      animationFrame = 0;
      context.clearRect(0, 0, window.innerWidth, window.innerHeight);

      while (trail.length && now - trail[0].bornAt > trailDuration) {
        trail.shift();
      }

      if (trail.length > 1) {
        const head = trail[trail.length - 1];
        const tail = trail[0];
        const gradient = context.createLinearGradient(
          tail.x,
          tail.y,
          head.x,
          head.y,
        );
        gradient.addColorStop(0, "rgb(44 170 255 / 0%)");
        gradient.addColorStop(0.52, "rgb(44 170 255 / 24%)");
        gradient.addColorStop(0.82, "rgb(87 187 255 / 70%)");
        gradient.addColorStop(1, "rgb(255 255 255 / 96%)");

        context.save();
        context.globalCompositeOperation = "lighter";
        context.lineCap = "round";
        context.lineJoin = "round";
        context.strokeStyle = gradient;
        context.lineWidth = 2.2;
        context.shadowColor = "rgb(44 170 255 / 82%)";
        context.shadowBlur = 12;
        context.beginPath();
        trail.forEach((point, index) => {
          if (index === 0) context.moveTo(point.x, point.y);
          else context.lineTo(point.x, point.y);
        });
        context.stroke();

        const glow = context.createRadialGradient(
          head.x,
          head.y,
          0,
          head.x,
          head.y,
          13,
        );
        glow.addColorStop(0, "rgb(255 255 255 / 100%)");
        glow.addColorStop(0.18, "rgb(193 235 255 / 92%)");
        glow.addColorStop(0.52, "rgb(44 170 255 / 38%)");
        glow.addColorStop(1, "rgb(44 170 255 / 0%)");
        context.fillStyle = glow;
        context.beginPath();
        context.arc(head.x, head.y, 13, 0, Math.PI * 2);
        context.fill();
        context.restore();
      }

      context.save();
      context.globalCompositeOperation = "lighter";
      for (let index = clickBursts.length - 1; index >= 0; index -= 1) {
        const burst = clickBursts[index];
        const progress = Math.min((now - burst.bornAt) / clickBurstDuration, 1);

        if (progress >= 1) {
          clickBursts.splice(index, 1);
          continue;
        }

        const easedProgress = 1 - Math.pow(1 - progress, 3);
        const opacity = Math.pow(1 - progress, 2);
        const primaryRadius = 7 + easedProgress * 30;
        const secondaryRadius = 4 + easedProgress * 19;

        context.save();
        context.translate(burst.x, burst.y);
        context.rotate(burst.rotation + easedProgress * 0.16);
        context.shadowColor = `rgb(44 170 255 / ${opacity * 75}%)`;
        context.shadowBlur = 13 * opacity;

        context.strokeStyle = `rgb(87 187 255 / ${opacity * 68}%)`;
        context.lineWidth = Math.max(0.55, 1.45 * (1 - progress));
        context.beginPath();
        context.arc(0, 0, primaryRadius, 0, Math.PI * 2);
        context.stroke();

        context.strokeStyle = `rgb(0 221 177 / ${opacity * 54}%)`;
        context.lineWidth = Math.max(0.45, 1.05 * (1 - progress));
        context.beginPath();
        context.arc(0, 0, secondaryRadius, 0, Math.PI * 2);
        context.stroke();

        const outerRadius = 12 + easedProgress * 5;
        const innerRadius = 2.2 + (1 - progress) * 1.8;
        context.fillStyle = `rgb(235 250 255 / ${opacity * 94}%)`;
        context.beginPath();
        for (let pointIndex = 0; pointIndex < 8; pointIndex += 1) {
          const angle = -Math.PI / 2 + pointIndex * Math.PI / 4;
          const radius = pointIndex % 2 === 0 ? outerRadius : innerRadius;
          const pointX = Math.cos(angle) * radius;
          const pointY = Math.sin(angle) * radius;
          if (pointIndex === 0) context.moveTo(pointX, pointY);
          else context.lineTo(pointX, pointY);
        }
        context.closePath();
        context.fill();

        const coreGlow = context.createRadialGradient(0, 0, 0, 0, 0, 9);
        coreGlow.addColorStop(0, `rgb(255 255 255 / ${opacity * 100}%)`);
        coreGlow.addColorStop(0.3, `rgb(87 187 255 / ${opacity * 78}%)`);
        coreGlow.addColorStop(1, "rgb(44 170 255 / 0%)");
        context.fillStyle = coreGlow;
        context.beginPath();
        context.arc(0, 0, 9, 0, Math.PI * 2);
        context.fill();
        context.restore();
      }
      context.restore();

      context.save();
      context.globalCompositeOperation = "lighter";
      for (let index = sparks.length - 1; index >= 0; index -= 1) {
        const spark = sparks[index];
        spark.x += spark.vx;
        spark.y += spark.vy;
        spark.vx *= 0.982;
        spark.vy = spark.vy * 0.982 + 0.008;
        spark.life -= spark.decay;

        if (spark.life <= 0) {
          sparks.splice(index, 1);
          continue;
        }

        const color = spark.aqua ? "0 221 177" : "87 187 255";
        context.strokeStyle = `rgb(${color} / ${spark.life * 72}%)`;
        context.fillStyle = `rgb(255 255 255 / ${spark.life * 88}%)`;
        context.shadowColor = `rgb(${color} / 80%)`;
        context.shadowBlur = 7;
        context.lineWidth = Math.max(0.45, spark.size * 0.45);
        context.beginPath();
        context.moveTo(spark.x - spark.vx * 5, spark.y - spark.vy * 5);
        context.lineTo(spark.x + spark.vx * 1.5, spark.y + spark.vy * 1.5);
        context.stroke();
        context.beginPath();
        context.arc(spark.x, spark.y, spark.size * spark.life, 0, Math.PI * 2);
        context.fill();
      }
      context.restore();

      if (trail.length || sparks.length || clickBursts.length) {
        animationFrame = window.requestAnimationFrame(drawMeteor);
      }
    };

    const startAnimation = () => {
      if (!animationFrame) {
        animationFrame = window.requestAnimationFrame(drawMeteor);
      }
    };

    const updateTrail = (event: PointerEvent) => {
      const points = event.getCoalescedEvents?.() ?? [event];
      const now = performance.now();

      for (const point of points) {
        const dx = point.clientX - lastX;
        const dy = point.clientY - lastY;
        const distance = Math.hypot(dx, dy);
        if (distance < 2) continue;

        trail.push({ x: point.clientX, y: point.clientY, bornAt: now });
        if (trail.length > 18) trail.shift();

        if (now - lastSparkAt > 18) {
          const speed = Math.min(distance, 30);
          const amount = Math.min(3, Math.max(1, Math.round(speed / 9)));
          for (let index = 0; index < amount && sparks.length < maxSparks; index += 1) {
            const drift = (Math.random() - 0.5) * 1.15;
            sparks.push({
              x: point.clientX - dx * Math.random() * 0.34,
              y: point.clientY - dy * Math.random() * 0.34,
              vx: -dx * 0.025 + drift,
              vy: -dy * 0.025 + (Math.random() - 0.5) * 1.15,
              size: 0.75 + Math.random() * 1.35,
              life: 0.72 + Math.random() * 0.28,
              decay: 0.026 + Math.random() * 0.018,
              aqua: Math.random() > 0.66,
            });
          }
          lastSparkAt = now;
        }

        lastX = point.clientX;
        lastY = point.clientY;
      }

      startAnimation();
    };

    const createClickBurst = (event: PointerEvent) => {
      if (!event.isPrimary || event.button !== 0) return;

      const now = performance.now();
      clickBursts.push({
        x: event.clientX,
        y: event.clientY,
        bornAt: now,
        rotation: Math.random() * Math.PI * 0.5,
      });
      if (clickBursts.length > 3) clickBursts.shift();

      const particleCount = 18;
      for (let index = 0; index < particleCount && sparks.length < maxSparks; index += 1) {
        const angle = (Math.PI * 2 * index) / particleCount + (Math.random() - 0.5) * 0.24;
        const velocity = 1.1 + Math.random() * 2.7;
        sparks.push({
          x: event.clientX + Math.cos(angle) * 4,
          y: event.clientY + Math.sin(angle) * 4,
          vx: Math.cos(angle) * velocity,
          vy: Math.sin(angle) * velocity,
          size: 0.75 + Math.random() * 1.25,
          life: 0.82 + Math.random() * 0.18,
          decay: 0.032 + Math.random() * 0.018,
          aqua: index % 3 === 0,
        });
      }

      startAnimation();
    };

    const clearTrail = () => {
      trail.splice(0, trail.length);
      lastX = -100;
      lastY = -100;
      startAnimation();
    };

    resizeCanvas();
    window.addEventListener("resize", resizeCanvas, { passive: true });
    window.addEventListener("pointermove", updateTrail, { passive: true });
    window.addEventListener("pointerdown", createClickBurst, { passive: true });
    document.documentElement.addEventListener("pointerleave", clearTrail, {
      passive: true,
    });

    return () => {
      window.removeEventListener("resize", resizeCanvas);
      window.removeEventListener("pointermove", updateTrail);
      window.removeEventListener("pointerdown", createClickBurst);
      document.documentElement.removeEventListener("pointerleave", clearTrail);
      if (animationFrame) window.cancelAnimationFrame(animationFrame);
      context.clearRect(0, 0, window.innerWidth, window.innerHeight);
    };
  }

  function initializeScrollMotion() {
    const previousCleanup = window.__campusScrollMotionCleanup;
    previousCleanup?.();

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;
    const cleanupMeteorTrail =
      !reduceMotion && finePointer ? initializeMeteorCursorTrail() : () => {};
    const root = document.documentElement;
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("#contenido-principal > :not(style):not(script)"),
    );
    const headings = Array.from(
      document.querySelectorAll<HTMLElement>("#contenido-principal h1, #contenido-principal h2"),
    );

    headings.forEach((heading, index) => {
      heading.dataset.motionHeading = "true";
      heading.dataset.motionIndex = String(index + 1).padStart(2, "0");
    });

    document
      .querySelectorAll<HTMLElement>("#contenido-principal .btn-primary, #contenido-principal .btn-outline")
      .forEach((action) => action.dataset.motionAction = "true");

    document.querySelectorAll<HTMLImageElement>("#contenido-principal img").forEach((image) => {
      const imageBox = image.getBoundingClientRect();
      if (
        !image.closest(".page-hero") &&
        imageBox.width >= 240 &&
        imageBox.height >= 140
      ) {
        image.dataset.motionMedia = "true";
      }
    });

    const hero = sections[0];
    const heroPieces = hero
      ? Array.from(
          hero.querySelectorAll<HTMLElement>("h1, h2, p, a[href], button"),
        )
          .slice(0, 10)
      : [];

    hero?.setAttribute("data-hero-intro", "true");
    heroPieces.forEach((piece, index) => {
      piece.dataset.heroPiece = "true";
      piece.style.setProperty("--motion-delay", `${120 + index * 90}ms`);
    });

    const visualConsole = document.querySelector<HTMLElement>(".code-console-shell");
    const pageFooter = document.querySelector<HTMLElement>("footer");
    const footerObserver = new IntersectionObserver((entries) => {
      const footerIsVisible = entries.some((entry) => entry.isIntersecting);
      if (visualConsole) {
        visualConsole.dataset.footerHidden = String(footerIsVisible);
      }
    }, { threshold: 0.01 });

    if (pageFooter && visualConsole) {
      footerObserver.observe(pageFooter);
    }

    if (reduceMotion) {
      sections.forEach((section) => section.dataset.scrollVisible = "true");
      hero?.setAttribute("data-hero-ready", "true");
      root.style.setProperty("--code-scroll", "0px");
      root.style.setProperty("--scroll-progress", "0");
      window.__campusScrollMotionCleanup = () => {
        footerObserver.disconnect();
        visualConsole?.removeAttribute("data-footer-hidden");
        cleanupMeteorTrail();
      };
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.scrollVisible = "true";
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -8%" },
    );

    sections.forEach((section, index) => {
      if (index === 0) {
        section.dataset.scrollVisible = "true";
        return;
      }
      section.dataset.scrollReveal = index % 2 === 0 ? "left" : "right";
      if (section.getBoundingClientRect().top < window.innerHeight * 0.92) {
        section.dataset.scrollVisible = "true";
      } else {
        observer.observe(section);
      }
    });

    let frame = 0;
    let pointerFrame = 0;
    let pointerX = window.innerWidth * 0.7;
    let pointerY = window.innerHeight * 0.35;
    const heroFrame = window.requestAnimationFrame(() => {
      window.requestAnimationFrame(() => hero?.setAttribute("data-hero-ready", "true"));
    });

    const updateScrollDetails = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        root.style.setProperty("--code-scroll", `${window.scrollY}px`);
        const scrollableHeight = Math.max(
          document.documentElement.scrollHeight - window.innerHeight,
          1,
        );
        root.style.setProperty(
          "--scroll-progress",
          String(Math.min(window.scrollY / scrollableHeight, 1)),
        );
        frame = 0;
      });
    };

    const updatePointerDetails = (event: PointerEvent) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (pointerFrame) return;
      pointerFrame = window.requestAnimationFrame(() => {
        root.style.setProperty("--pointer-x", `${pointerX}px`);
        root.style.setProperty("--pointer-y", `${pointerY}px`);
        pointerFrame = 0;
      });
    };

    window.addEventListener("scroll", updateScrollDetails, { passive: true });
    if (finePointer) {
      window.addEventListener("pointermove", updatePointerDetails, { passive: true });
    }
    updateScrollDetails();

    window.__campusScrollMotionCleanup = () => {
      observer.disconnect();
      footerObserver.disconnect();
      visualConsole?.removeAttribute("data-footer-hidden");
      window.removeEventListener("scroll", updateScrollDetails);
      window.removeEventListener("pointermove", updatePointerDetails);
      if (frame) window.cancelAnimationFrame(frame);
      if (pointerFrame) window.cancelAnimationFrame(pointerFrame);
      window.cancelAnimationFrame(heroFrame);
      cleanupMeteorTrail();
    };
  }

  document.addEventListener("astro:page-load", initializeScrollMotion);
  document.addEventListener("astro:before-swap", () => {
    window.__campusScrollMotionCleanup?.();
  });
</script>
