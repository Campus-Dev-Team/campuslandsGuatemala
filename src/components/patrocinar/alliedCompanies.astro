---
import { Image } from 'astro:assets';
import vensura from '~/assets/img/companies/patrocina/vensura-optimizado.webp';
import zonafranca from '~/assets/img/companies/patrocina/ZONA_FRANCA.svg';
import fenalco from '~/assets/img/companies/patrocina/fenalco-optimizado.webp';
import marval from '~/assets/img/companies/patrocina/marval.svg';
import grupoSura from '~/assets/img/companies/patrocina/grupoSura.svg';
import andi from '~/assets/img/companies/patrocina/andi-optimizado.webp';
import camaraComercio from '~/assets/img/companies/patrocina/camaraComercio.svg';
import fedesoft from '~/assets/img/companies/patrocina/fedesoft-optimizado.webp';
---

<section class="allied-companies overflow-hidden relative sections max-w-[1150px] self-center">
	<div class="mb-10">
		<p class="text-2xl md:text-[32px] text-center mb-5 px-4 lg:px-0 gradient-text font-bold max-w-[400px] mx-auto">Aliados transformando nuestro talento joven</p>
		<p class="text-sm lg:text-base text-center">En Campuslands, sabemos que el cambio comienza con un apoyo genuino.</p>
	</div>
	<div class="overflow-hidden">
		<div class="flex flex-wrap gap-6 mx-auto max-w-[1150psx] justify-center">
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={vensura} alt="Vensure, empresa aliada de Campuslands" widths={[217, 320, 434]} sizes="(max-width: 1023px) 48vw, 18vw" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={zonafranca} alt="Zona Franca Santander, aliada de Campuslands" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={fenalco} alt="Fenalco Santander, aliado de Campuslands" widths={[217, 320, 434]} sizes="(max-width: 1023px) 48vw, 18vw" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={marval} alt="Marval, empresa aliada de Campuslands" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={grupoSura} alt="Grupo Sura, aliado de Campuslands" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={andi} alt="ANDI, aliado de Campuslands" widths={[217, 320, 434]} sizes="(max-width: 1023px) 48vw, 18vw" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={camaraComercio} alt="Cámara de Comercio de Bucaramanga, aliada de Campuslands" loading="lazy" decoding="async" />
			</div>
			<div class="w-[48%] lg:w-[18%] h-fit flex items-center justify-center">
				<Image src={fedesoft} alt="Fedesoft, aliado de Campuslands" widths={[217, 320, 434]} sizes="(max-width: 1023px) 48vw, 18vw" loading="lazy" decoding="async" />
			</div>
		</div>
	</div>
</section>
