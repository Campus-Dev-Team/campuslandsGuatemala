---
import { Image } from "astro:assets";
import formacionPresencial from "~/assets/img/patrocina/transformacion/formacion-presencial.webp";
import comunidadAprendizaje from "~/assets/img/patrocina/transformacion/comunidad-aprendizaje.webp";
import programacionCampus from "~/assets/img/patrocina/transformacion/programacion-en-campus.webp";
import talentoTecnologico from "~/assets/img/patrocina/transformacion/talento-tecnologico.webp";

const scenes = [
  {
    src: formacionPresencial,
    alt: "Campers de Campuslands Guatemala durante una sesión de formación presencial",
    label: "Formación",
    className: "scene--one",
    loading: "eager" as const,
    fetchpriority: "high" as const,
  },
  {
    src: comunidadAprendizaje,
    alt: "Jóvenes de Campuslands Guatemala compartiendo una experiencia de aprendizaje",
    label: "Comunidad",
    className: "scene--two",
    loading: "lazy" as const,
    fetchpriority: "auto" as const,
  },
  {
    src: programacionCampus,
    alt: "Campers desarrollando proyectos de programación en las instalaciones de Campuslands",
    label: "Programación",
    className: "scene--three",
    loading: "lazy" as const,
    fetchpriority: "auto" as const,
  },
  {
    src: talentoTecnologico,
    alt: "Talento joven de Guatemala concentrado en su formación tecnológica",
    label: "Talento tech",
    className: "scene--four",
    loading: "lazy" as const,
    fetchpriority: "auto" as const,
  },
];
---

<div
  class="transformation-gallery"
  role="group"
  aria-label="Experiencias de formación y comunidad en Campuslands Guatemala"
>
  <svg
    class="circuit-network"
    viewBox="0 0 100 120"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="route-gradient" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#00aa80" />
        <stop offset="0.48" stop-color="#2caaff" />
        <stop offset="1" stop-color="#57bbff" />
      </linearGradient>
      <filter id="route-glow" x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="1.8" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <path
      id="transformation-route"
      class="route route--base"
      pathLength="100"
      d="M 67 6 H 88 Q 96 6 96 15 V 24 Q 96 33 87 33 H 18 Q 8 33 8 43 V 50 Q 8 60 18 60 H 82 Q 92 60 92 70 V 78 Q 92 88 82 88 H 22 Q 12 88 12 99 V 110 H 55"
    />
    <path
      class="route route--energy"
      pathLength="100"
      d="M 67 6 H 88 Q 96 6 96 15 V 24 Q 96 33 87 33 H 18 Q 8 33 8 43 V 50 Q 8 60 18 60 H 82 Q 92 60 92 70 V 78 Q 92 88 82 88 H 22 Q 12 88 12 99 V 110 H 55"
    />
    <path
      class="route route--beam"
      pathLength="100"
      d="M 67 6 H 88 Q 96 6 96 15 V 24 Q 96 33 87 33 H 18 Q 8 33 8 43 V 50 Q 8 60 18 60 H 82 Q 92 60 92 70 V 78 Q 92 88 82 88 H 22 Q 12 88 12 99 V 110 H 55"
    />

    <g class="route-nodes">
      <circle cx="96" cy="24" r="1.25" />
      <circle cx="8" cy="50" r="1.25" />
      <circle cx="92" cy="78" r="1.25" />
      <circle cx="12" cy="99" r="1.25" />
    </g>

    <circle class="energy-particle energy-particle--one" r="1.15">
      <animateMotion dur="4.8s" repeatCount="indefinite">
        <mpath href="#transformation-route" />
      </animateMotion>
    </circle>
    <circle class="energy-particle energy-particle--two" r="0.75">
      <animateMotion dur="4.8s" begin="-2.4s" repeatCount="indefinite">
        <mpath href="#transformation-route" />
      </animateMotion>
    </circle>
  </svg>

  {scenes.map((scene, index) => (
    <figure class={`gallery-scene ${scene.className}`}>
      <div class="scene-border" aria-hidden="true"></div>
      <Image
        src={scene.src}
        alt={scene.alt}
        widths={[320, 480, 720]}
        width={720}
        format="avif"
        quality={64}
        loading={scene.loading}
        fetchpriority={scene.fetchpriority}
        decoding="async"
        sizes="(max-width: 767px) 48vw, (max-width: 1023px) 36vw, 300px"
      />
      <figcaption>
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        {scene.label}
      </figcaption>
    </figure>
  ))}

  <span class="gallery-code gallery-code--left" aria-hidden="true">&lt;impacto&gt;</span>
  <span class="gallery-code gallery-code--right" aria-hidden="true">future.commit()</span>
</div>

<style>
  .transformation-gallery {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 0.84;
    isolation: isolate;
  }

  .circuit-network {
    position: absolute;
    inset: 2% 1% 1%;
    z-index: 0;
    width: 98%;
    height: 97%;
    overflow: visible;
    pointer-events: none;
  }

  .route {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .route--base {
    stroke: rgb(87 187 255 / 24%);
    stroke-width: 7;
    filter: url("#route-glow");
  }

  .route--energy {
    stroke: url("#route-gradient");
    stroke-width: 3;
    stroke-dasharray: 3 7;
    animation: route-flow 1.7s linear infinite;
  }

  .route--beam {
    stroke: #b7efff;
    stroke-width: 4.5;
    stroke-dasharray: 11 89;
    filter: url("#route-glow");
    animation: route-beam 5.2s cubic-bezier(0.45, 0, 0.2, 1) infinite;
  }

  .route-nodes circle {
    fill: #000051;
    stroke: #57bbff;
    stroke-width: 0.65;
    vector-effect: non-scaling-stroke;
    filter: url("#route-glow");
    transform-box: fill-box;
    transform-origin: center;
    animation: route-node-pulse 2.5s ease-in-out infinite;
  }

  .route-nodes circle:nth-child(2) { animation-delay: -0.6s; }
  .route-nodes circle:nth-child(3) { animation-delay: -1.2s; }
  .route-nodes circle:nth-child(4) { animation-delay: -1.8s; }

  .energy-particle {
    fill: #d8f8ff;
    filter: url("#route-glow");
  }

  .energy-particle--two { fill: #00aa80; }

  .gallery-scene {
    --scene-radius: 1.75rem;
    position: absolute;
    z-index: 2;
    overflow: hidden;
    margin: 0;
    border-radius: var(--scene-radius);
    background: #07102b;
    box-shadow:
      0 1.5rem 3.2rem rgb(0 0 30 / 34%),
      0 0 0 1px rgb(87 187 255 / 12%);
    transform: translateZ(0);
    transition:
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 500ms ease;
  }

  .gallery-scene::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      linear-gradient(120deg, transparent 24%, rgb(87 187 255 / 17%) 44%, transparent 61%),
      linear-gradient(180deg, transparent 58%, rgb(0 0 30 / 72%) 100%);
    background-position: 140% 0, 0 0;
    background-size: 220% 100%, 100% 100%;
    transition: background-position 650ms ease;
  }

  .gallery-scene img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.94) contrast(1.02);
    transition:
      transform 700ms cubic-bezier(0.18, 0.8, 0.2, 1),
      filter 500ms ease;
  }

  .scene-border {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    border: 0.11rem solid rgb(87 187 255 / 40%);
    border-radius: inherit;
    box-shadow: inset 0 0 1.3rem rgb(44 170 255 / 8%);
    transition: border-color 400ms ease, box-shadow 400ms ease;
  }

  .gallery-scene figcaption {
    position: absolute;
    right: 1rem;
    bottom: 0.72rem;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: white;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(0.55rem);
    transition: opacity 350ms ease, transform 350ms ease;
  }

  .gallery-scene figcaption span {
    color: #57bbff;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  .scene--one {
    top: 0;
    right: 1%;
    width: 49%;
    height: 25%;
  }

  .scene--one img { object-position: 70% 48%; }

  .scene--two {
    top: 27%;
    left: 1%;
    width: 44%;
    height: 25%;
  }

  .scene--two img { object-position: 63% 52%; }

  .scene--three {
    top: 52%;
    right: 2%;
    width: 45%;
    height: 25%;
  }

  .scene--three img { object-position: 58% 50%; }

  .scene--four {
    left: 8%;
    bottom: 0.5%;
    width: 45%;
    height: 24%;
  }

  .scene--four img { object-position: 40% 50%; }

  .gallery-scene:hover,
  .gallery-scene:focus-within {
    z-index: 6;
    transform: translateY(-0.55rem) scale(1.035);
    box-shadow:
      0 1.8rem 4rem rgb(0 0 30 / 46%),
      0 0 2rem rgb(44 170 255 / 22%);
  }

  .gallery-scene:hover img,
  .gallery-scene:focus-within img {
    transform: scale(1.055);
    filter: saturate(1.08) contrast(1.06) brightness(1.025);
  }

  .gallery-scene:hover::after,
  .gallery-scene:focus-within::after {
    background-position: -80% 0, 0 0;
  }

  .gallery-scene:hover .scene-border,
  .gallery-scene:focus-within .scene-border {
    border-color: #57bbff;
    box-shadow:
      inset 0 0 1.5rem rgb(44 170 255 / 12%),
      0 0 1.25rem rgb(87 187 255 / 36%);
  }

  .gallery-scene:hover figcaption,
  .gallery-scene:focus-within figcaption {
    opacity: 1;
    transform: translateY(0);
  }

  .gallery-code {
    position: absolute;
    z-index: 1;
    color: rgb(87 187 255 / 34%);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
  }

  .gallery-code--left { top: 18%; left: 1%; transform: rotate(-90deg); }
  .gallery-code--right { right: 1%; bottom: 1%; }

  @media (max-width: 767px) {
    .transformation-gallery {
      width: min(100%, 24rem);
      aspect-ratio: 0.78;
      margin-inline: auto;
    }

    .circuit-network {
      inset: 1%;
      width: 98%;
      height: 98%;
    }

    .gallery-scene { --scene-radius: 1.2rem; }
    .scene--one { top: 0; right: 0; width: 54%; height: 23%; }
    .scene--two { top: 26%; left: 0; width: 47%; height: 23%; }
    .scene--three { top: 52%; right: 0; width: 50%; height: 23%; }
    .scene--four { left: 5%; bottom: 0; width: 48%; height: 23%; }

    .gallery-scene figcaption {
      right: 0.6rem;
      bottom: 0.5rem;
      font-size: 0.56rem;
    }

    .gallery-code { display: none; }
  }

  @media (hover: none) {
    .gallery-scene figcaption {
      opacity: 0.9;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route--energy,
    .route--beam,
    .route-nodes circle {
      animation: none;
    }

    .energy-particle { display: none; }

    .gallery-scene,
    .gallery-scene img,
    .gallery-scene::after,
    .scene-border,
    .gallery-scene figcaption {
      transition: none;
    }
  }

  @keyframes route-flow {
    to { stroke-dashoffset: -10; }
  }

  @keyframes route-beam {
    0% { stroke-dashoffset: 12; opacity: 0; }
    12% { opacity: 1; }
    78% { opacity: 1; }
    100% { stroke-dashoffset: -88; opacity: 0; }
  }

  @keyframes route-node-pulse {
    0%, 100% { transform: scale(0.86); opacity: 0.72; }
    50% { transform: scale(1.48); opacity: 1; }
  }
</style>
