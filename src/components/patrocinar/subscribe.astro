---
import { Image } from 'astro:assets';
import myImage from '~/assets/img/patrocina/camper-patrocinio-guatemala.webp';
---

<section class="principal sections max-w-[1150px] self-center relative h-fit">
	<div class="relative mx-auto flex flex-wrap justify-between h-fit w-full px-10 md:px-50 lg:px-0 max-w-7xl">
		<figure
			class="sponsor-tech-visual my-auto flex-grow lg:flex-1 w-full max-w-[595px]"
			aria-label="Camper desarrollando sus habilidades tecnológicas"
			tabindex="0"
		>
			<div class="sponsor-tech-visual__stage">
				<span class="sponsor-tech-visual__glow" aria-hidden="true"></span>
				<span class="sponsor-tech-visual__orbit sponsor-tech-visual__orbit--one" aria-hidden="true"></span>
				<span class="sponsor-tech-visual__orbit sponsor-tech-visual__orbit--two" aria-hidden="true"></span>
				<span class="sponsor-tech-visual__grid" aria-hidden="true"></span>
				<span class="sponsor-tech-visual__scan" aria-hidden="true"></span>

				<div class="sponsor-code-layer" aria-hidden="true">
					<code class="sponsor-code sponsor-code--one">const talento = "GT";</code>
					<code class="sponsor-code sponsor-code--two">deploy("sueños");</code>
					<code class="sponsor-code sponsor-code--three">if (oportunidad) futuro++;</code>
					<code class="sponsor-code sponsor-code--four">skills.map(crecer);</code>
					<code class="sponsor-code sponsor-code--five">&lt;camper ready={'{true}'} /&gt;</code>
				</div>

				<Image
					src={myImage}
					alt="Camper de Campuslands Guatemala trabajando en su computadora portátil"
					width={978}
					widths={[320, 480, 595, 768, 978]}
					format="avif"
					quality={80}
					loading="lazy"
					decoding="async"
					sizes="(max-width: 1023px) min(90vw, 595px), 595px"
					class="sponsor-tech-visual__photo"
				/>
			</div>
		</figure>

		<div class="my-auto w-full lg:w-6/12 place-items-center">
			<div class="flex w-full md:max-w-[350px] lg:w-[455px] lg:max-w-[455px] flex-col gap-y-8 relative">
				<p class="gradient-text text-center lg:text-start text-2xl lg:text-[32px] leading-[48px] lg:leading-[60px] f-700"> Suscríbete y construyamos un futuro inclusivo juntos </p>
				<p class="text-center lg:text-start text-sm lg:text-base leading-6 text-white"> Tu apoyo permite abrir puertas hacia un futuro lleno de oportunidades, donde ellos pueden desarrollar su máximo potencial, aprender habilidades clave para el mundo laboral y convertirse en agentes de cambio en sus comunidades. </p>
				<a
					href="https://mail.google.com/mail/?view=cm&fs=1&to=jorge@quantic.la&su=Interés en Programa de Patrocinio - [Nombre Empresa]"
					target="_blank"
					rel="noopener noreferrer"
					class="btn-primary w-full sm:max-w-[305px] lg:me-auto f-600 h-12 lg:h-14 px-6 flex justify-center items-center gap-x-2 z-30"
				>
					Suscríbete a Campuslands
					<img src="/img/icons/heartdark.svg" alt="" class="hidden lg:block">
				</a>
			</div>
		</div>
	</div>
	<img src="/img/textura-lateral-derecha.svg" alt="" class="absolute top-0 right-0">
	<img src="/img/textura-lateral-izquierda.svg" alt="" class="absolute top-0 left-0">
</section>

<style scoped>
.sponsor-tech-visual {
	position: relative;
	margin-inline: auto;
	outline: none;
}

.sponsor-tech-visual__stage {
	position: relative;
	isolation: isolate;
	aspect-ratio: 1 / 1;
	transform: translateZ(0);
}

.sponsor-tech-visual__glow {
	position: absolute;
	z-index: 0;
	inset: 12% 8% 9%;
	border-radius: 44% 56% 48% 52% / 48% 42% 58% 52%;
	background:
		radial-gradient(circle at 58% 38%, rgb(44 170 255 / .58), transparent 36%),
		radial-gradient(circle at 32% 70%, rgb(0 170 128 / .48), transparent 42%),
		linear-gradient(145deg, rgb(0 0 135 / .82), rgb(0 0 81 / .3));
	filter: blur(clamp(18px, 3vw, 32px));
	opacity: .78;
	animation: sponsor-glow-pulse 4.8s cubic-bezier(.45, 0, .55, 1) infinite;
}

.sponsor-tech-visual__orbit {
	position: absolute;
	z-index: 1;
	left: 50%;
	top: 50%;
	border: 1px solid rgb(87 187 255 / .3);
	border-radius: 50%;
	box-shadow: 0 0 24px rgb(44 170 255 / .14), inset 0 0 24px rgb(0 170 128 / .08);
	pointer-events: none;
}

.sponsor-tech-visual__orbit--one {
	width: 82%;
	aspect-ratio: 1;
	transform: translate(-50%, -50%) rotate(-12deg);
	border-style: dashed;
	animation: sponsor-orbit-one 18s linear infinite;
}

.sponsor-tech-visual__orbit--two {
	width: 61%;
	aspect-ratio: 1;
	transform: translate(-50%, -50%) rotate(18deg);
	border-color: rgb(0 170 128 / .24);
	animation: sponsor-orbit-two 13s linear infinite reverse;
}

.sponsor-tech-visual__grid {
	position: absolute;
	z-index: 1;
	inset: 10%;
	pointer-events: none;
	opacity: .18;
	background-image:
		linear-gradient(rgb(87 187 255 / .32) 1px, transparent 1px),
		linear-gradient(90deg, rgb(87 187 255 / .32) 1px, transparent 1px);
	background-size: 42px 42px;
	mask-image: radial-gradient(circle, black 20%, transparent 70%);
}

.sponsor-tech-visual__scan {
	position: absolute;
	z-index: 4;
	left: 11%;
	top: 10%;
	width: 78%;
	height: 2px;
	pointer-events: none;
	background: linear-gradient(90deg, transparent, rgb(87 187 255 / .85), rgb(0 170 128 / .9), transparent);
	box-shadow: 0 0 16px rgb(44 170 255 / .72);
	opacity: 0;
	animation: sponsor-scan 5.8s ease-in-out infinite;
}

.sponsor-tech-visual__photo {
	position: absolute;
	z-index: 3;
	left: 50%;
	bottom: 1%;
	display: block;
	width: 96%;
	height: auto;
	transform: translateX(-50%);
	filter: drop-shadow(0 24px 32px rgb(0 0 0 / .3));
	transition: transform 800ms cubic-bezier(.16, 1, .3, 1), filter 800ms ease;
}

.sponsor-code-layer {
	position: absolute;
	inset: 0;
	z-index: 5;
	pointer-events: none;
}

.sponsor-code {
	position: absolute;
	display: block;
	max-width: 48%;
	padding: .42rem .62rem;
	overflow: hidden;
	color: #EAF8FF;
	font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	font-size: clamp(.54rem, 1.15vw, .72rem);
	font-weight: 700;
	line-height: 1;
	white-space: nowrap;
	letter-spacing: .03em;
	border: 1px solid rgb(87 187 255 / .34);
	border-radius: .45rem;
	background: rgb(0 0 81 / .7);
	box-shadow: 0 0 18px rgb(44 170 255 / .18), inset 0 0 12px rgb(0 170 128 / .08);
	backdrop-filter: blur(7px);
	opacity: 0;
	clip-path: inset(0 100% 0 0);
	transform: translateY(14px) scale(.96);
}

.sponsor-code::after {
	content: "_";
	margin-left: .15rem;
	color: #00AA80;
	animation: sponsor-cursor 1s steps(2, end) infinite;
}

.sponsor-code--one { top: 13%; left: 2%; }
.sponsor-code--two { top: 29%; right: 0; }
.sponsor-code--three { top: 52%; left: 0; }
.sponsor-code--four { right: 2%; bottom: 22%; }
.sponsor-code--five { left: 11%; bottom: 7%; }

.sponsor-tech-visual:hover .sponsor-code,
.sponsor-tech-visual:focus-visible .sponsor-code {
	animation: sponsor-code-reveal .82s steps(18, end) forwards;
}

.sponsor-tech-visual:hover .sponsor-code--two,
.sponsor-tech-visual:focus-visible .sponsor-code--two { animation-delay: 90ms; }
.sponsor-tech-visual:hover .sponsor-code--three,
.sponsor-tech-visual:focus-visible .sponsor-code--three { animation-delay: 180ms; }
.sponsor-tech-visual:hover .sponsor-code--four,
.sponsor-tech-visual:focus-visible .sponsor-code--four { animation-delay: 270ms; }
.sponsor-tech-visual:hover .sponsor-code--five,
.sponsor-tech-visual:focus-visible .sponsor-code--five { animation-delay: 360ms; }

.sponsor-tech-visual:hover .sponsor-tech-visual__photo,
.sponsor-tech-visual:focus-visible .sponsor-tech-visual__photo {
	filter: drop-shadow(0 30px 42px rgb(0 0 0 / .38)) saturate(1.06);
	transform: translateX(-50%) translateY(-1.5%) scale(1.025);
}

.sponsor-tech-visual:hover .sponsor-tech-visual__glow,
.sponsor-tech-visual:focus-visible .sponsor-tech-visual__glow {
	opacity: 1;
	filter: blur(clamp(22px, 3.4vw, 38px)) saturate(1.16);
}

@keyframes sponsor-glow-pulse {
	0%, 100% { transform: scale(.92) rotate(-2deg); opacity: .58; }
	50% { transform: scale(1.07) rotate(2deg); opacity: .96; }
}

@keyframes sponsor-orbit-one {
	to { transform: translate(-50%, -50%) rotate(348deg); }
}

@keyframes sponsor-orbit-two {
	to { transform: translate(-50%, -50%) rotate(378deg); }
}

@keyframes sponsor-scan {
	0%, 12% { transform: translateY(0); opacity: 0; }
	20% { opacity: .75; }
	72% { opacity: .32; }
	82%, 100% { transform: translateY(430px); opacity: 0; }
}

@keyframes sponsor-code-reveal {
	0% { opacity: 0; clip-path: inset(0 100% 0 0); transform: translateY(14px) scale(.96); }
	35% { opacity: 1; }
	100% { opacity: 1; clip-path: inset(0); transform: translateY(0) scale(1); }
}

@keyframes sponsor-cursor {
	50% { opacity: 0; }
}

@media (hover: none) {
	.sponsor-code--one,
	.sponsor-code--four {
		opacity: .5;
		clip-path: inset(0);
		transform: none;
		animation: sponsor-touch-code 4s ease-in-out infinite;
	}

	.sponsor-code--four { animation-delay: -2s; }
}

@keyframes sponsor-touch-code {
	0%, 100% { transform: translateY(0); opacity: .34; }
	50% { transform: translateY(-6px); opacity: .68; }
}

@media (prefers-reduced-motion: reduce) {
	.sponsor-tech-visual__glow,
	.sponsor-tech-visual__orbit,
	.sponsor-tech-visual__scan,
	.sponsor-code,
	.sponsor-code::after,
	.sponsor-tech-visual__photo {
		animation: none;
		transition: none;
	}

	.sponsor-tech-visual__scan { display: none; }
}
</style>
