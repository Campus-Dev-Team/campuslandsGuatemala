---
import { Image } from 'astro:assets';
import myImage from '~/assets/img/campers/campers-home-border-girl.png';
import ContactButton from '../common/ContactButton.astro';
---
<section class="page-hero principal self-center sections relative w-full px-4 lg:px-9" aria-label="Sección de introducción sobre Campuslands">
	<div class="relative flex flex-col lg:flex-row flex-wrap justify-center lg:justify-between h-fit w-full max-w-[1150px] items-center gap-8 lg:gap-10 m-0 p-0">
		<!-- Contenedor de texto y botón -->
		<div class="relative flex flex-col w-full md:max-w-[550px] lg:max-w-[425px] gap-y-4 lg:gap-y-8 items-center lg:items-start px-4 lg:px-0" title="Información sobre Campuslands">
			<img src="/img/cohete1.png" alt="Cohete ilustrativo despegando" width="122" height="122" class="absolute -right-28 hidden lg:block" loading="lazy">

            <h1 class="page-title gradient-text text-center lg:text-start">
                Formación en programación para jóvenes en Guatemala
			</h1>

            <p class="text-center lg:text-start text-sm lg:text-base leading-5 lg:leading-6 text-white">
                Campuslands Guatemala forma a jóvenes en desarrollo de software, inglés y habilidades profesionales para impulsar su acceso al sector tecnológico.
            </p>

            <ContactButton whatsApp='+50232705200' tipo="contacto" iconName='happyFace.svg' alt='cara feliz'/>
        </div>

		<!-- Contenedor de las imágenes -->
		<div class="w-full max-w-[635px] lg:w-auto flex justify-center" aria-label="Imagen representativa de estudiantes">
			<Image
				src={myImage}
				alt="Campers estudiando programación en Campuslands Guatemala"
				width={635}
				widths={[320, 480, 635, 960, 1280]}
				format="avif"
				loading="eager"
				fetchpriority="high"
				sizes="(max-width: 1023px) min(90vw, 635px), 635px"
				class="w-full h-auto"
			/>
		</div>
	</div>
</section>

<style scoped>
.bg-students {
    position: absolute;
    bottom: 0px;
    right: 0px;
    width: 90%;
    max-width: 90%;
    max-height: 70%;
}

.principal {
    background-position: 80% 0%;
    background-repeat: no-repeat;
    background-size: 75%;
}

.heartbeat{-webkit-animation:heartbeat 4s ease-in-out infinite both;animation:heartbeat 4s ease-in-out infinite both}
