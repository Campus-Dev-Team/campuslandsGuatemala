---
import ContactButton from "./common/ContactButton.astro";

const contactNumber = "+50232705200";
---

<section
  class="flex flex-wrap w-full lg:max-w-[1130px] gap-x-20 max-w-[1150px] sections self-center justify-center relative h-fit overflow-hidden"
>
  <a
    href="https://www.google.com/maps/place/Campuslands+Guatemala/@14.6222245,-90.5168285,17z/data=!3m1!4b1!4m6!3m5!1s0x8589a3b61a018d91:0x3b8f5bb6cc476d2b!8m2!3d14.6222193!4d-90.5142536!16s%2Fg%2F11ys3sw_hd?entry=ttu&g_ep=EgoyMDI2MDgwNC4wIKXMDSoASAFQAw%3D%3D"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Ver Campuslands Guatemala en Google Maps"
  >
    <img
      src="/img/mapa.webp"
      alt="Mapa de la ubicación de Campuslands Guatemala en Campus Tec, zona 4"
      class="w-4/6 lg:w-[420px] max-h-[420px] mx-auto"
      width="840"
      height="842"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="max-w-[550px] my-auto flex flex-col gap-y-8">
    <h2
      class="gradient-text text-xl text-center lg:text-start lg:text-4xl font-bold mt-5"
    >
      Visita nuestra instalación en campus Tec, vive la experiencia Campuslands Guatemala
  </h2>
    <p class="text-white font-semibold">
      Visítanos en Edificio Campus Tec, Vía 4 1-00, Zona 4, Torre 1,
      7.º nivel, Ciudad de Guatemala 01004. Agenda una cita y descubre cómo
      puedes ser parte de Campuslands como estudiante, empleador o patrocinador.
    </p>
    <div class="flex flex-wrap justify-center md:flex-nowrap gap-6">
      <ContactButton
        tipo="agendar"
        whatsApp={contactNumber}
        iconName="agenda.svg"
        StylesButton="md:max-w-[216px]"
      />
      <ContactButton
        tipo="chatear"
        whatsApp={contactNumber}
        iconName="whatsapp.svg"
        isOutline
        StylesButton="md:max-w-[300px]"
      />
    </div>
  </div>
</section>
