---
import {
  absoluteUrl,
  colombiaAlternateFor,
  DEFAULT_IMAGE,
  LAST_CONTENT_UPDATE,
  normalizePathname,
  organizationSchema,
  PAGE_SEO,
  SITE,
  SITE_URL,
  websiteSchema,
} from "../config/seo.mjs";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  pageType?: "WebPage" | "AboutPage" | "CollectionPage" | "Article";
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  noindex = false,
  pageType = "WebPage",
  publishedTime,
  modifiedTime,
  author,
  structuredData = [],
} = Astro.props;

const pathname = normalizePathname(Astro.url.pathname);
const pageSeo = PAGE_SEO[pathname] ?? {};
const pageTitle = title ?? pageSeo.title ?? SITE.name;
const pageDescription =
  description ??
  pageSeo.description ??
  "Formación tecnológica intensiva y presencial en Ciudad de Guatemala.";
const canonical = absoluteUrl(SITE_URL, pathname);
const colombiaAlternate = colombiaAlternateFor(pathname);
const socialImage = image.startsWith("http") ? image : new URL(image, SITE_URL).toString();
const usesDefaultSocialImage = socialImage === DEFAULT_IMAGE;
const robots = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";

const graph: Record<string, unknown>[] = [];
if (!noindex) {
  graph.push(organizationSchema(), websiteSchema());
  graph.push({
    "@type": pageType,
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: pageTitle,
    description: pageDescription,
    dateModified: LAST_CONTENT_UPDATE,
    inLanguage: SITE.language,
    isAccessibleForFree: true,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    about: { "@id": `${SITE_URL}/#organization` },
    publisher: { "@id": `${SITE_URL}/#organization` },
    keywords: pageSeo.keywords,
    contentLocation: {
      "@type": "Place",
      name: "Campuslands Guatemala",
      address: {
        "@type": "PostalAddress",
        ...SITE.address,
      },
    },
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: socialImage,
    },
  });

  if (pathname !== "/") {
    graph.push({
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Inicio",
          item: `${SITE_URL}/`,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: pageTitle.split("|")[0].trim(),
          item: canonical,
        },
      ],
    });
  }

  graph.push(
    ...(Array.isArray(structuredData) ? structuredData : [structuredData]),
  );
}

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": graph,
}).replace(/</g, "\\u003c");
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={SITE.name} />
<meta http-equiv="content-language" content={SITE.language} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="text/plain" href={`${SITE_URL}/llms.txt`} title="Resumen para asistentes" />
<link rel="alternate" type="text/markdown" href={`${SITE_URL}/informacion-campuslands.md`} title="Información oficial en Markdown" />
<link rel="alternate" type="application/json" href={`${SITE_URL}/informacion-campuslands.json`} title="Información oficial en JSON" />
{!noindex && <link rel="alternate" hreflang="es-GT" href={canonical} />}
{
  !noindex && colombiaAlternate && (
    <>
      <link rel="alternate" hreflang="es-CO" href={colombiaAlternate} />
      <link rel="alternate" hreflang="x-default" href={colombiaAlternate} />
    </>
  )
}
<meta property="og:type" content={pageType === "Article" ? "article" : "website"} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:locale:alternate" content="es_CO" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:updated_time" content={LAST_CONTENT_UPDATE} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={`Campuslands Guatemala — ${pageTitle}`} />
{usesDefaultSocialImage && <meta property="og:image:type" content="image/jpeg" />}
{usesDefaultSocialImage && <meta property="og:image:width" content="1200" />}
{usesDefaultSocialImage && <meta property="og:image:height" content="630" />}
{pageType === "Article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{pageType === "Article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{pageType === "Article" && author && <meta property="article:author" content={author} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={`Campuslands Guatemala — ${pageTitle}`} />
<meta name="theme-color" content="#07102B" />
<link rel="manifest" href="/site.webmanifest" />
{!noindex && <script type="application/ld+json" set:html={jsonLd}></script>}
