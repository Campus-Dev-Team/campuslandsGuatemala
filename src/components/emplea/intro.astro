---
import { Image } from "astro:assets";
import ContactButton from "../common/ContactButton.astro";
import myImage from "~/assets/img/emplea/emplea-home.png";
---

<section
  class="principal flex flex-col sections max-w-[1150px] self-center relative h-fit items-center md:flex-row gap-8"
>
  <div
    class="relative flex-wrap w-full md:max-w-[350px] lg:w-[425px] lg:max-w-[425px] flex flex-col gap-8 items-center md:items-start"
  >
    <h1
      class="gradient-text text-center lg:text-start lg:text-[40px] text-[24px] leading-10 lg:leading-[60px] f-700"
    >
      Encuentra el talento tech competitivo que tu empresa necesita, sin
      complicaciones.
    </h1>
    <p
      class="text-center lg:text-start text-sm lg:text-base leading-6 text-white"
    >
      Identificamos jóvenes con potencial, los entrenamos en desarrollo de
      software, dominio del inglés y competencias socioemocionales, entregando
      candidatos ideales para tu equipo.
    </p>
    <ContactButton
      tipo="emplear"
      whatsApp="+50232705200"
      iconName="arm.svg"
      StylesAnchor="place-items-center"
    />
  </div>
  <div class="w-full max-w-[530px]">
    <Image
      src={myImage}
      alt="Campers de Campuslands Guatemala preparados para integrarse a empresas"
      width={530}
      widths={[320, 480, 530, 800, 1060]}
      format="avif"
      loading="eager"
      fetchpriority="high"
      sizes="(max-width: 767px) min(90vw, 530px), 530px"
      class="w-full h-auto"
    />
  </div>
</section>

<style scoped>
  .bg-students {
    position: absolute;
    bottom: 0px;
    right: 0px;
    width: 90%;
    max-width: 90%;
    max-height: 70%;
  }

  .principal {
    margin-bottom: 10rem;

    /* background-image: url('img/texxture.svg'); */
    background-position: 80% 0%;
    background-repeat: no-repeat;
    background-size: 75%;
  }
</style>
