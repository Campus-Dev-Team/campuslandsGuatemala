---
import LayoutNavbar from "../../../layouts/LayoutNavbar.astro";
import { colorRgb, formatBlogDate, getBlogData, safeCategoryColor } from "../../../lib/blog";
import { SITE, SITE_URL } from "../../../config/seo.mjs";
import "~/styles/index.css";

const { settings, galleries } = await getBlogData();
const title = settings ? `${settings.galleriesTitle} | ${settings.publicationName}` : undefined;
const description = settings?.galleriesDescription;
const dataFooter = settings ? { title: settings.footerTitle, content: settings.footerDescription, buttonType: "contacto" } : undefined;
const structuredData = settings ? [{
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/blog/galerias/#collection`,
  name: settings.galleriesTitle,
  description: settings.galleriesDescription,
  inLanguage: SITE.language,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: galleries.length,
    itemListElement: galleries.map((gallery, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: gallery.title,
      url: `${SITE_URL}/blog/galerias/${gallery.slug}/`,
    })),
  },
}] : undefined;
---

<LayoutNavbar dataFooter={dataFooter} title={title} description={description} pageType="CollectionPage" structuredData={structuredData}>
  <main class="gallery-index">
    {settings ? (
      <>
        <header class="gallery-index__hero sections">
          <nav aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/blog/">{settings.publicationName}</a><span>/</span><b>{settings.galleriesLabel}</b></nav>
          <p><i></i>{settings.galleriesLabel}</p>
          <h1>{settings.galleriesTitle}</h1>
          <div><span>{settings.galleriesDescription}</span><b>{String(galleries.length).padStart(2, "0")}<small>colecciones</small></b></div>
        </header>
        <section class="gallery-index__grid sections" aria-label={settings.galleriesTitle}>
          {galleries.map((gallery, index) => (
            <article style={`--category:${safeCategoryColor(gallery.category.color)};--category-rgb:${colorRgb(gallery.category.color)}`}>
              <a href={`/blog/galerias/${gallery.slug}/`}>
                <div class="gallery-index__mosaic">
                  {gallery.images.slice(0, 3).map((image, imageIndex) => <img src={image.url} alt={image.alternativeText || gallery.title} loading={index < 2 ? "eager" : "lazy"} decoding="async" class:list={[{ main: imageIndex === 0 }]} />)}
                  {!gallery.images.length && <span>{`{ 00 }`}</span>}
                  <b>{String(gallery.images.length).padStart(2, "0")}</b>
                </div>
                <div class="gallery-index__body"><p><i></i>{gallery.category.name}</p><h2>{gallery.title}</h2><span>{gallery.description}</span><footer><small>{formatBlogDate(gallery.publishDate)}</small><b>{settings.viewGalleryLabel} ↗</b></footer></div>
              </a>
            </article>
          ))}
        </section>
        {!galleries.length && <section class="gallery-index__empty sections"><span>{`{ 00 }`}</span><h2>{settings.emptyTitle}</h2><p>{settings.emptyDescription}</p><a href="/blog/">{settings.emptyButtonLabel}</a></section>}
      </>
    ) : <section class="gallery-index__empty sections"><span>CMS / SIN CONEXIÓN</span><h1>Las galerías están temporalmente en preparación.</h1></section>}
  </main>
</LayoutNavbar>

<style>
  .gallery-index{--max:1320px;position:relative;padding-bottom:4rem}.gallery-index:before{position:absolute;inset:0 0 auto;z-index:-1;height:42rem;background:radial-gradient(circle at 82% 6%,rgb(0 217 164/13%),transparent 25%),radial-gradient(circle at 8% 25%,rgb(87 187 255/14%),transparent 27%);content:""}.gallery-index__hero{max-width:var(--max);margin:0 auto;padding-top:clamp(2rem,6vw,5.5rem)}.gallery-index__hero nav{display:flex;align-items:center;gap:.6rem;color:rgb(255 255 255/38%);font:600 .64rem/1 monospace;letter-spacing:.09em;text-transform:uppercase}.gallery-index__hero nav a{color:rgb(255 255 255/58%);text-decoration:none}.gallery-index__hero>p{display:flex;margin-top:clamp(3rem,7vw,6rem);align-items:center;gap:.75rem;color:#00d9a4;font:700 .7rem/1 monospace;letter-spacing:.15em;text-transform:uppercase}.gallery-index__hero>p i{width:2rem;height:1px;background:#00d9a4;box-shadow:0 0 .8rem #00d9a4}.gallery-index__hero h1{max-width:980px;margin-top:1.2rem;color:#fff;font-size:clamp(3rem,8vw,7rem);font-weight:780;line-height:.96;letter-spacing:-.065em;text-wrap:balance}.gallery-index__hero>div{display:flex;margin-top:2rem;padding-top:1.5rem;align-items:flex-end;justify-content:space-between;gap:2rem;border-top:1px solid rgb(87 187 255/20%)}.gallery-index__hero>div>span{max-width:700px;color:rgb(255 255 255/58%);font-size:clamp(.92rem,1.8vw,1.12rem);line-height:1.7}.gallery-index__hero>div>b{display:grid;color:#fff;font-size:3rem;font-weight:400;line-height:1}.gallery-index__hero>div small{margin-top:.35rem;color:rgb(255 255 255/38%);font:600 .56rem/1 monospace;letter-spacing:.1em;text-transform:uppercase}.gallery-index__grid{display:grid;max-width:var(--max);margin:clamp(3rem,7vw,6rem) auto 0;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.15rem}.gallery-index__grid article{min-width:0;border:1px solid rgb(var(--category-rgb)/22%);border-radius:1.5rem;background:linear-gradient(160deg,rgb(var(--category-rgb)/6%),rgb(7 16 43/72%));overflow:hidden;transition:transform .28s,border-color .28s}.gallery-index__grid article:hover{transform:translateY(-.4rem);border-color:rgb(var(--category-rgb)/55%)}.gallery-index__grid article>a{display:grid;height:100%;padding:.55rem;color:inherit;text-decoration:none}.gallery-index__mosaic{display:grid;position:relative;min-height:20rem;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:.35rem;border-radius:1.15rem;background:#02091e;overflow:hidden}.gallery-index__mosaic img{width:100%;height:100%;object-fit:cover}.gallery-index__mosaic img.main{grid-row:1/-1}.gallery-index__mosaic>span{display:grid;grid-column:1/-1;grid-row:1/-1;place-content:center;color:var(--category);font:700 2rem/1 monospace}.gallery-index__mosaic>b{position:absolute;right:.75rem;bottom:.75rem;padding:.48rem .62rem;border:1px solid rgb(255 255 255/15%);border-radius:99px;color:#fff;background:rgb(0 3 20/75%);font:700 .66rem/1 monospace}.gallery-index__body{display:flex;min-height:14.5rem;padding:1.3rem 1rem 1rem;flex-direction:column}.gallery-index__body>p{display:flex;align-items:center;gap:.55rem;color:var(--category);font:700 .62rem/1 monospace;letter-spacing:.1em;text-transform:uppercase}.gallery-index__body>p i{width:1.2rem;height:1px;background:currentColor}.gallery-index__body h2{margin-top:.85rem;color:#fff;font-size:clamp(1.4rem,2.5vw,2rem);line-height:1.16;letter-spacing:-.035em}.gallery-index__body>span{display:-webkit-box;margin-top:.7rem;color:rgb(255 255 255/51%);font-size:.79rem;line-height:1.6;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.gallery-index__body footer{display:flex;margin-top:auto;padding-top:1rem;align-items:center;justify-content:space-between;color:rgb(255 255 255/35%);font-size:.66rem}.gallery-index__body footer b{color:var(--category);font-weight:650}.gallery-index__empty{max-width:var(--max);margin:4rem auto;padding:5rem 1rem;border:1px dashed rgb(87 187 255/28%);border-radius:1.5rem;text-align:center}.gallery-index__empty>span{color:#57bbff;font:700 1.5rem/1 monospace}.gallery-index__empty h1,.gallery-index__empty h2{margin-top:1rem;color:#fff}.gallery-index__empty p{margin-top:.7rem;color:rgb(255 255 255/55%)}.gallery-index__empty a{display:inline-flex;margin-top:1.3rem;padding:.75rem 1rem;border-radius:99px;color:#031326;background:#00d9a4;text-decoration:none;font-weight:700}@media(max-width:820px){.gallery-index__grid{grid-template-columns:1fr}.gallery-index__mosaic{min-height:18rem}}@media(max-width:620px){.gallery-index__hero>div{align-items:flex-start;flex-direction:column}.gallery-index__mosaic{min-height:15rem}.gallery-index__body{min-height:13rem}}
</style>
