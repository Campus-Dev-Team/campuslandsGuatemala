---
import LayoutNavbar from "../../../layouts/LayoutNavbar.astro";
import { blogSeoDescription, blogSeoTitle, colorRgb, formatBlogDate, getBlogData, safeCategoryColor, type BlogGallery, type BlogSettings } from "../../../lib/blog";
import { SITE, SITE_URL } from "../../../config/seo.mjs";
import "~/styles/index.css";

export async function getStaticPaths() {
  const { galleries, settings } = await getBlogData();
  if (!settings) return [];
  return galleries.map((gallery) => ({ params: { slug: gallery.slug }, props: { gallery, settings } }));
}

interface Props { gallery: BlogGallery; settings: BlogSettings }
const { gallery, settings } = Astro.props;
const category = safeCategoryColor(gallery.category.color);
const rgb = colorRgb(category);
const pageUrl = `${SITE_URL}/blog/galerias/${gallery.slug}/`;
const image = gallery.seo?.shareImage?.url || gallery.images[0]?.url;
const seoTitle = blogSeoTitle(gallery.seo?.metaTitle, `${gallery.title} | ${settings.publicationName}`);
const seoDescription = blogSeoDescription(gallery.seo?.metaDescription, gallery.description);
const dataFooter = { title: settings.articleFooterTitle, content: settings.articleFooterDescription, buttonType: "contacto" };
const structuredData = [{
  "@type": "ImageGallery",
  "@id": `${pageUrl}#gallery`,
  name: gallery.title,
  description: gallery.description,
  datePublished: gallery.publishDate,
  inLanguage: SITE.language,
  url: pageUrl,
  associatedMedia: gallery.images.map((item) => ({ "@type": "ImageObject", contentUrl: item.url, caption: item.caption || item.alternativeText })),
  publisher: { "@id": `${SITE_URL}/#organization` },
}, {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE_URL}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
    { "@type": "ListItem", position: 3, name: settings.galleriesLabel, item: `${SITE_URL}/blog/galerias/` },
    { "@type": "ListItem", position: 4, name: gallery.title, item: pageUrl },
  ],
}];
---

<LayoutNavbar dataFooter={dataFooter} title={seoTitle} description={seoDescription} image={image} pageType="Article" publishedTime={gallery.publishDate} structuredData={structuredData}>
  <div class="gallery-page" style={`--category:${category};--category-rgb:${rgb}`}>
    <header class="gallery-page__hero sections">
      <nav aria-label="Migas de pan"><a href="/">Inicio</a><span>/</span><a href="/blog/">{settings.publicationName}</a><span>/</span><a href="/blog/galerias/">{settings.galleriesLabel}</a></nav>
      <div><p><i></i>{gallery.category.name}</p><h1>{gallery.title}</h1><span>{gallery.description}</span><footer><small>{formatBlogDate(gallery.publishDate)}</small><b>{String(gallery.images.length).padStart(2, "0")} imágenes</b></footer></div>
    </header>
    <section class="gallery-page__collection sections" aria-labelledby="gallery-images-label">
      <div class="gallery-page__label"><span id="gallery-images-label">{settings.galleryImagesLabel}</span><p>Selecciona una imagen para abrir la presentación. Usa ← → para recorrerla.</p></div>
      <div class="gallery-page__grid" data-public-gallery>
        {gallery.images.map((item, index) => (
          <button type="button" data-public-gallery-image data-src={item.url} data-alt={item.alternativeText || gallery.title} data-caption={item.caption || ""} aria-label={`Abrir imagen ${index + 1} de ${gallery.images.length}`}>
            <img src={item.url} alt={item.alternativeText || gallery.title} width={item.width} height={item.height} loading={index < 3 ? "eager" : "lazy"} decoding="async" />
            <span>{String(index + 1).padStart(2, "0")}</span>
            {item.caption && <small>{item.caption}</small>}
          </button>
        ))}
      </div>
      <a class="gallery-page__back" href="/blog/galerias/">← {settings.galleriesLabel}</a>
    </section>
  </div>
</LayoutNavbar>

<script>
  const gallery = document.querySelector<HTMLElement>("[data-public-gallery]");
  const buttons = gallery ? Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-public-gallery-image]")) : [];
  if (buttons.length) {
    const modal = document.createElement("div");
    modal.className = "public-gallery-modal";
    modal.hidden = true;
    modal.innerHTML = '<header><span data-count></span><div><button type="button" data-auto>Auto 5s</button><button type="button" data-close aria-label="Cerrar">×</button></div></header><figure><img data-main alt=""/><figcaption data-caption></figcaption></figure><button type="button" data-prev class="prev" aria-label="Anterior">←</button><button type="button" data-next class="next" aria-label="Siguiente">→</button><div data-thumbs></div>';
    document.body.append(modal);
    const image = modal.querySelector<HTMLImageElement>("[data-main]")!;
    const caption = modal.querySelector<HTMLElement>("[data-caption]")!;
    const count = modal.querySelector<HTMLElement>("[data-count]")!;
    const thumbs = modal.querySelector<HTMLElement>("[data-thumbs]")!;
    let current = 0;
    let timer = 0;
    let playing = false;
    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length;
      const item = buttons[current];
      image.src = item.dataset.src || ""; image.alt = item.dataset.alt || "";
      caption.textContent = item.dataset.caption || ""; caption.hidden = !caption.textContent;
      count.textContent = `${String(current + 1).padStart(2,"0")} / ${String(buttons.length).padStart(2,"0")}`;
      Array.from(thumbs.children).forEach((thumb, i) => thumb.classList.toggle("active", i === current));
    };
    buttons.forEach((button, index) => {
      const thumb = document.createElement("button"); thumb.type = "button"; thumb.innerHTML = `<img src="${button.dataset.src || ""}" alt=""/>`; thumb.addEventListener("click", () => show(index)); thumbs.append(thumb);
      button.addEventListener("click", () => { show(index); modal.hidden = false; document.body.style.overflow = "hidden"; modal.querySelector<HTMLButtonElement>("[data-close]")?.focus(); });
    });
    const stop = () => { if (timer) window.clearInterval(timer); timer = 0; playing = false; const control = modal.querySelector<HTMLButtonElement>("[data-auto]"); if (control) control.textContent = "Auto 5s"; };
    const close = () => { modal.hidden = true; document.body.style.overflow = ""; stop(); };
    modal.querySelector("[data-close]")?.addEventListener("click", close);
    modal.querySelector("[data-prev]")?.addEventListener("click", () => show(current - 1));
    modal.querySelector("[data-next]")?.addEventListener("click", () => show(current + 1));
    modal.querySelector("[data-auto]")?.addEventListener("click", () => { if (playing) return stop(); playing = true; timer = window.setInterval(() => show(current + 1), 5000); (modal.querySelector("[data-auto]") as HTMLButtonElement).textContent = "Pausar"; });
    modal.addEventListener("click", (event) => { if (event.target === modal) close(); });
    window.addEventListener("keydown", (event) => { if (modal.hidden) return; if (event.key === "Escape") close(); if (event.key === "ArrowLeft") show(current - 1); if (event.key === "ArrowRight") show(current + 1); });
  }
</script>

<style is:global>
  .gallery-page{position:relative}.gallery-page:before{position:absolute;inset:0 0 auto;z-index:-1;height:55rem;background:radial-gradient(circle at 80% 9%,rgb(var(--category-rgb)/20%),transparent 28%),radial-gradient(circle at 7% 32%,rgb(87 187 255/11%),transparent 24%);content:""}.gallery-page__hero{max-width:1180px;margin:0 auto;padding-top:clamp(2rem,6vw,5rem)}.gallery-page__hero nav{display:flex;align-items:center;gap:.6rem;color:rgb(255 255 255/38%);font:600 .64rem/1 monospace;text-transform:uppercase}.gallery-page__hero nav a{color:rgb(255 255 255/58%);text-decoration:none}.gallery-page__hero>div{max-width:980px;margin-top:clamp(3.5rem,8vw,7rem)}.gallery-page__hero p{display:flex;align-items:center;gap:.7rem;color:var(--category);font:700 .68rem/1 monospace;letter-spacing:.13em;text-transform:uppercase}.gallery-page__hero p i{width:2rem;height:1px;background:currentColor;box-shadow:0 0 .8rem currentColor}.gallery-page__hero h1{margin-top:1.2rem;color:#fff;font-size:clamp(3rem,8vw,7rem);font-weight:780;line-height:.96;letter-spacing:-.065em;text-wrap:balance}.gallery-page__hero>div>span{display:block;max-width:760px;margin-top:1.7rem;color:rgb(255 255 255/61%);font-size:clamp(1rem,2vw,1.18rem);line-height:1.75}.gallery-page__hero footer{display:flex;margin-top:1.8rem;gap:1rem;color:rgb(255 255 255/38%);font:.68rem/1 monospace}.gallery-page__hero footer b{color:var(--category)}.gallery-page__collection{max-width:1280px;margin:clamp(4rem,9vw,8rem) auto 0}.gallery-page__label{display:flex;margin-bottom:1.2rem;align-items:end;justify-content:space-between;gap:1rem}.gallery-page__label span{color:var(--category);font:700 .68rem/1 monospace;letter-spacing:.13em}.gallery-page__label p{color:rgb(255 255 255/38%);font-size:.7rem}.gallery-page__grid{display:grid;grid-template-columns:repeat(12,1fr);grid-auto-flow:dense;gap:.65rem}.gallery-page__grid button{display:block;position:relative;grid-column:span 4;padding:0;border:1px solid rgb(var(--category-rgb)/22%);border-radius:1.2rem;background:#02091e;overflow:hidden;cursor:zoom-in}.gallery-page__grid button:nth-child(7n+1),.gallery-page__grid button:nth-child(7n+5){grid-column:span 8}.gallery-page__grid img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .35s}.gallery-page__grid button:nth-child(7n+1) img,.gallery-page__grid button:nth-child(7n+5) img{aspect-ratio:16/8}.gallery-page__grid button:hover img{transform:scale(1.035)}.gallery-page__grid button>span{position:absolute;top:.65rem;left:.65rem;padding:.42rem .52rem;border-radius:99px;color:#031326;background:var(--category);font:800 .57rem/1 monospace}.gallery-page__grid button>small{position:absolute;right:.65rem;bottom:.65rem;left:.65rem;padding:.65rem;border-radius:.7rem;color:#fff;background:rgb(0 3 20/74%);font-size:.68rem;text-align:left;backdrop-filter:blur(12px)}.gallery-page__back{display:inline-flex;margin:3rem 0 6rem;color:var(--category);font-size:.78rem;text-decoration:none}.public-gallery-modal{display:grid;position:fixed;inset:0;z-index:1000;padding:4.8rem 5rem 5.5rem;place-items:center;color:#fff;background:rgb(0 3 18/97%);backdrop-filter:blur(18px)}.public-gallery-modal[hidden]{display:none}.public-gallery-modal>header{display:flex;position:absolute;top:0;left:0;width:100%;min-height:4.2rem;padding:.8rem 1.2rem;align-items:center;justify-content:space-between;border-bottom:1px solid rgb(255 255 255/10%)}.public-gallery-modal>header>span{color:#71d8ff;font:700 .7rem/1 monospace;letter-spacing:.13em}.public-gallery-modal>header>div{display:flex;gap:.4rem}.public-gallery-modal button{border:1px solid rgb(255 255 255/12%);border-radius:.7rem;color:#fff;background:rgb(255 255 255/5%);cursor:pointer}.public-gallery-modal header button{min-height:2.3rem;padding:0 .75rem}.public-gallery-modal figure{display:grid;width:100%;height:100%;margin:0;place-content:center;justify-items:center}.public-gallery-modal figure img{display:block;max-width:100%;max-height:calc(100vh - 11rem);object-fit:contain}.public-gallery-modal figcaption{margin-top:.7rem;color:rgb(255 255 255/56%);font-size:.72rem}.public-gallery-modal>.prev,.public-gallery-modal>.next{position:absolute;top:50%;width:3rem;height:3rem;border-radius:50%;font-size:1.1rem}.public-gallery-modal>.prev{left:1rem}.public-gallery-modal>.next{right:1rem}.public-gallery-modal>[data-thumbs]{display:flex;position:absolute;right:0;bottom:0;left:0;height:5rem;padding:.55rem;justify-content:center;gap:.4rem;border-top:1px solid rgb(255 255 255/8%);overflow-x:auto}.public-gallery-modal>[data-thumbs] button{width:5.2rem;flex:0 0 auto;padding:.12rem;border-color:transparent;opacity:.42}.public-gallery-modal>[data-thumbs] button.active{border-color:#00d9a4;opacity:1}.public-gallery-modal>[data-thumbs] img{width:100%;height:3.5rem;object-fit:cover}@media(max-width:850px){.gallery-page__grid button,.gallery-page__grid button:nth-child(7n+1),.gallery-page__grid button:nth-child(7n+5){grid-column:span 6}.gallery-page__grid button:nth-child(7n+1) img,.gallery-page__grid button:nth-child(7n+5) img{aspect-ratio:4/3}}@media(max-width:620px){.gallery-page__label{align-items:flex-start;flex-direction:column}.gallery-page__grid button,.gallery-page__grid button:nth-child(7n+1),.gallery-page__grid button:nth-child(7n+5){grid-column:1/-1}.public-gallery-modal{padding:4.5rem 2.7rem 5.5rem}.public-gallery-modal>.prev{left:.1rem}.public-gallery-modal>.next{right:.1rem}}
</style>
