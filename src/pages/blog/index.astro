---
import LayoutNavbar from "../../layouts/LayoutNavbar.astro";
import BlogCover from "../../components/blog/BlogCover.astro";
import {
  colorRgb,
  formatBlogDate,
  getBlogData,
  safeCategoryColor,
} from "../../lib/blog";
import { SITE, SITE_URL } from "../../config/seo.mjs";
import "~/styles/index.css";

const { settings, categories, articles, galleries, source } = await getBlogData();

const dataFooter = settings
  ? {
      title: settings.footerTitle,
      content: settings.footerDescription,
      buttonType: "contacto",
    }
  : undefined;

const structuredData = settings
  ? [
      {
        "@type": "Blog",
        "@id": `${SITE_URL}/blog/#blog`,
        url: `${SITE_URL}/blog/`,
        name: settings.publicationName,
        headline: settings.heroTitle,
        description: settings.seoDescription,
        inLanguage: SITE.language,
        publisher: { "@id": `${SITE_URL}/#organization` },
        blogPost: articles.map((article) => ({
          "@type": "BlogPosting",
          "@id": `${SITE_URL}/blog/${article.slug}/#article`,
          headline: article.title,
          description: article.excerpt,
          datePublished: article.publishDate,
          url: `${SITE_URL}/blog/${article.slug}/`,
          articleSection: article.category.name,
          author: {
            "@type": "Organization",
            name: article.authorName,
          },
        })),
      },
      {
        "@type": "ItemList",
        "@id": `${SITE_URL}/blog/#publicaciones`,
        name: settings.archiveTitle,
        numberOfItems: articles.length,
        itemListOrder: "https://schema.org/ItemListOrderDescending",
        itemListElement: articles.map((article, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: article.title,
          url: `${SITE_URL}/blog/${article.slug}/`,
        })),
      },
    ]
  : undefined;
---

<LayoutNavbar
  dataFooter={dataFooter}
  title={settings?.seoTitle}
  description={settings?.seoDescription}
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="blog-index">
    {settings ? (
      <>
        <header class="blog-toolbar sections">
          <div class="blog-toolbar__title">
            <span aria-hidden="true"></span>
            <h1>{settings.publicationName}</h1>
          </div>
          <p id="blog-result-count" aria-live="polite">{articles.length} publicaciones</p>
        </header>

        <p class="sr-only">{settings.heroTitle} {settings.heroDescription}</p>

        {categories.length > 0 && (
          <nav class="category-console sections" aria-label="Filtrar publicaciones por categoría">
            <div class="category-console__topline">
              <p><span aria-hidden="true">&gt;</span> {settings.filterLabel}</p>
            </div>
            <div class="category-console__rail" data-category-filters>
              <button class="category-chip is-active" type="button" data-category="all" aria-pressed="true">
                <span class="category-chip__signal"></span>
                {settings.allCategoriesLabel}
              </button>
              {categories.map((category) => (
                <button
                  class="category-chip"
                  type="button"
                  data-category={category.slug}
                  data-description={category.description}
                  aria-pressed="false"
                  style={`--category-color:${safeCategoryColor(category.color)};--category-rgb:${colorRgb(category.color)}`}
                >
                  <span class="category-chip__signal"></span>
                  {category.name}
                </button>
              ))}
              {galleries.length > 0 && (
                <a class="category-chip category-chip--gallery" href="/blog/galerias/">
                  <span class="category-chip__signal"></span>
                  {settings.galleriesLabel} · {galleries.length}
                </a>
              )}
            </div>
            <p
              class="category-console__description"
              data-category-description
              data-default-description={settings.categoryIntro}
            >
              {settings.categoryIntro}
            </p>
          </nav>
        )}

        <section class="story-feed sections" aria-label={settings.archiveTitle}>
          <div class="story-grid" data-story-grid>
            {articles.map((article, index) => (
              <article
                class:list={["story-card", { "story-card--featured": article.featured }]}
                data-article-card
                data-category={article.category.slug}
                style={`--category-color:${safeCategoryColor(article.category.color)};--category-rgb:${colorRgb(article.category.color)}`}
              >
                <a href={`/blog/${article.slug}/`} aria-label={`Leer ${article.title}`}>
                  <BlogCover article={article} variant="card" index={index + 1} />
                  <div class="story-card__body">
                    <div class="story-card__topline">
                      <div class="story-card__category"><span></span>{article.category.name}</div>
                      {article.featured && <em>{settings.featuredLabel}</em>}
                    </div>
                    <h2>{article.title}</h2>
                    <p>{article.excerpt}</p>
                    <div class="story-card__footer">
                      <span>{formatBlogDate(article.publishDate)}</span>
                      <span>{article.readingTime} min</span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>

          <div class="story-empty" data-story-empty hidden={articles.length > 0}>
            <span aria-hidden="true">{`{ 00 }`}</span>
            <h2>{settings.emptyTitle}</h2>
            <p>{settings.emptyDescription}</p>
            <button type="button" data-reset-filter>{settings.emptyButtonLabel}</button>
          </div>
        </section>
      </>
    ) : (
      <section class="blog-service-state sections" aria-live="polite">
        <span>CMS / {source === "unavailable" ? "SIN CONEXIÓN" : "SIN CONFIGURAR"}</span>
        <h1>La publicación está temporalmente en preparación.</h1>
        <p>El contenido editorial volverá a mostrarse cuando la administración esté disponible.</p>
      </section>
    )}
  </div>
</LayoutNavbar>

<script>
  function initializeBlogFilters() {
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filters] [data-category]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-article-card]"));
    const count = document.querySelector<HTMLElement>("#blog-result-count");
    const description = document.querySelector<HTMLElement>("[data-category-description]");
    const empty = document.querySelector<HTMLElement>("[data-story-empty]");
    const reset = document.querySelector<HTMLButtonElement>("[data-reset-filter]");
    const defaultDescription = description?.dataset.defaultDescription || "";

    if (!filters.length || !cards.length) return;

    const selectCategory = (category: string, updateUrl = true) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = category === "all" || card.dataset.category === category;
        card.hidden = !show;
        if (show) visible += 1;
      });

      filters.forEach((filter) => {
        const active = filter.dataset.category === category;
        filter.classList.toggle("is-active", active);
        filter.setAttribute("aria-pressed", String(active));
      });

      const selected = filters.find((filter) => filter.dataset.category === category);
      if (count) count.textContent = `${visible} ${visible === 1 ? "publicación" : "publicaciones"}`;
      if (description) description.textContent = category === "all" ? defaultDescription : selected?.dataset.description || "";
      if (empty) empty.hidden = visible > 0;

      if (updateUrl) {
        const url = new URL(window.location.href);
        if (category === "all") url.searchParams.delete("categoria");
        else url.searchParams.set("categoria", category);
        history.replaceState({}, "", url);
      }
    };

    filters.forEach((filter) => filter.addEventListener("click", () => selectCategory(filter.dataset.category || "all")));
    reset?.addEventListener("click", () => selectCategory("all"));

    const requested = new URLSearchParams(window.location.search).get("categoria") || "all";
    selectCategory(filters.some((filter) => filter.dataset.category === requested) ? requested : "all", false);
  }

  document.addEventListener("DOMContentLoaded", initializeBlogFilters);
  document.addEventListener("astro:page-load", initializeBlogFilters);
</script>

<style>
  .blog-index {
    --blog-max: 1320px;
    position: relative;
    padding-bottom: 2rem;
  }

  .blog-index::before {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 24rem;
    background:
      radial-gradient(circle at 82% 4%, rgb(122 60 255 / 13%), transparent 25%),
      radial-gradient(circle at 10% 18%, rgb(44 170 255 / 12%), transparent 27%);
    content: "";
    pointer-events: none;
  }

  .blog-toolbar {
    display: flex;
    max-width: var(--blog-max);
    margin: 0 auto;
    padding-top: 1.35rem;
    padding-bottom: 0.85rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(87 187 255 / 20%);
  }

  .blog-toolbar__title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .blog-toolbar__title h1 {
    margin: 0;
    color: #8cd1ff;
    font: 700 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-toolbar__title span {
    width: 0.52rem;
    height: 0.52rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #00d9a4;
    box-shadow: 0 0 0 0.35rem rgb(0 217 164 / 9%), 0 0 0.85rem #00d9a4;
  }

  .blog-toolbar > p {
    color: rgb(255 255 255 / 45%);
    font: 600 0.67rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-console {
    max-width: var(--blog-max);
    margin: 0 auto;
    padding-top: 0.85rem;
    padding-bottom: 0.35rem;
  }

  .category-console__topline {
    display: flex;
    margin-bottom: 0.65rem;
    align-items: center;
    gap: 1rem;
    color: rgb(255 255 255 / 46%);
    font: 600 0.67rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-console__topline p:first-child span { color: #00d9a4; }

  .category-console__rail {
    display: flex;
    gap: 0.6rem;
    padding: 0.2rem 0 0.45rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .category-chip {
    --category-color: #57bbff;
    --category-rgb: 87 187 255;
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgb(var(--category-rgb) / 26%);
    border-radius: 999px;
    color: rgb(255 255 255 / 66%);
    background: rgb(255 255 255 / 3%);
    font-size: 0.8rem;
    transition: 180ms ease;
  }
  .category-chip--gallery { --category-color: #00d9a4; --category-rgb: 0 217 164; text-decoration: none; }

  .category-chip:hover,
  .category-chip.is-active {
    border-color: rgb(var(--category-rgb) / 78%);
    color: white;
    background: rgb(var(--category-rgb) / 14%);
    box-shadow: inset 0 0 1.2rem rgb(var(--category-rgb) / 8%);
  }

  .category-chip:focus-visible { outline: 2px solid var(--category-color); outline-offset: 3px; }
  .category-chip__signal { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--category-color); box-shadow: 0 0 0.8rem var(--category-color); }
  .category-console__description { min-height: 1.2rem; margin-top: 0.35rem; color: rgb(255 255 255 / 50%); font-size: 0.76rem; }

  .story-feed {
    max-width: var(--blog-max);
    margin: 0.9rem auto 0;
  }

  .story-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }

  .story-card {
    position: relative;
    min-width: 0;
    border: 1px solid rgb(var(--category-rgb) / 20%);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, rgb(var(--category-rgb) / 5%), rgb(7 16 43 / 68%));
    transition: border-color 240ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms ease;
  }

  .story-card--featured { border-color: rgb(var(--category-rgb) / 42%); }
  .story-card[hidden] { display: none; }
  .story-card:hover { border-color: rgb(var(--category-rgb) / 58%); transform: translateY(-0.4rem); box-shadow: 0 1.4rem 3.2rem rgb(0 0 30 / 30%); }
  .story-card > a { display: block; height: 100%; padding: 0.5rem; color: inherit; text-decoration: none; }
  .story-card > a:focus-visible { outline: 2px solid var(--category-color); outline-offset: 4px; border-radius: 1.2rem; }
  :global(.story-card .blog-cover--card) { min-height: 13.25rem; }

  .story-card__body { display: flex; min-height: 15.5rem; padding: 1.05rem 0.85rem 0.9rem; flex-direction: column; }
  .story-card__topline { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 0.45rem; }
  .story-card__category { display: flex; min-width: 0; align-items: center; gap: 0.45rem; color: var(--category-color); font: 600 0.59rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.065em; text-transform: uppercase; }
  .story-card__category span { width: 0.9rem; height: 1px; flex: 0 0 auto; background: var(--category-color); box-shadow: 0 0 0.55rem var(--category-color); }
  .story-card__topline em { flex: 0 0 auto; padding: 0.27rem 0.4rem; border: 1px solid rgb(var(--category-rgb) / 38%); border-radius: 999px; color: rgb(255 255 255 / 64%); font: 600 0.45rem/1 ui-monospace, monospace; font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; }
  .story-card h2 { margin-top: 0.9rem; color: white; font-size: clamp(1.05rem, 1.7vw, 1.3rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.025em; }
  .story-card__body > p { display: -webkit-box; margin-top: 0.7rem; overflow: hidden; color: rgb(255 255 255 / 54%); font-size: 0.76rem; line-height: 1.58; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .story-card__footer { display: flex; margin-top: auto; padding-top: 1.1rem; justify-content: space-between; gap: 0.75rem; color: rgb(255 255 255 / 38%); font-size: 0.61rem; }

  .story-empty { padding: 4rem 1.5rem; border: 1px dashed rgb(87 187 255 / 30%); border-radius: 1.5rem; text-align: center; }
  .story-empty span { color: #57bbff; font-family: monospace; font-size: 2rem; }
  .story-empty h2 { margin-top: 0.8rem; color: white; font-size: 1.5rem; }
  .story-empty p { margin: 0.65rem auto 0; max-width: 34rem; color: rgb(255 255 255 / 58%); }
  .story-empty button { min-height: 2.75rem; margin-top: 1.4rem; padding: 0.7rem 1.1rem; border-radius: 999px; color: #07102b; background: #00d9a4; font-weight: 700; }

  .blog-service-state { max-width: var(--blog-max); margin: 0 auto; padding-top: clamp(5rem, 12vw, 9rem); padding-bottom: 7rem; }
  .blog-service-state > span { color: #57bbff; font: 700 0.72rem/1 ui-monospace, monospace; letter-spacing: 0.14em; }
  .blog-service-state h1 { max-width: 54rem; margin-top: 1.4rem; color: white; font-size: clamp(2.5rem, 7vw, 5.5rem); line-height: 0.98; letter-spacing: -0.055em; }
  .blog-service-state p { max-width: 42rem; margin-top: 1.4rem; color: rgb(255 255 255 / 58%); line-height: 1.7; }

  @media (max-width: 1160px) {
    .story-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .story-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .blog-toolbar { padding-top: 1rem; }
    .blog-toolbar__title h1 { font-size: 0.7rem; }
    .category-console__rail { margin-right: -1rem; padding-right: 1rem; }
    .story-grid { grid-template-columns: 1fr; }
    .story-card__body { min-height: 13.5rem; }
  }
</style>
