---
import LayoutNavbar from "../../layouts/LayoutNavbar.astro";
import BlogCover from "../../components/blog/BlogCover.astro";
import {
  blogSeoDescription,
  blogSeoTitle,
  colorRgb,
  formatBlogDate,
  getBlogData,
  getBlogHeadings,
  renderBlogBlocks,
  safeCategoryColor,
  type BlogArticle,
  type BlogSettings,
} from "../../lib/blog";
import { DEFAULT_IMAGE, SITE, SITE_URL } from "../../config/seo.mjs";
import "~/styles/index.css";

export async function getStaticPaths() {
  const { articles, settings } = await getBlogData();
  if (!settings) return [];
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles, settings },
  }));
}

interface Props {
  article: BlogArticle;
  allArticles: BlogArticle[];
  settings: BlogSettings;
}

const { article, allArticles, settings } = Astro.props;
const categoryColor = safeCategoryColor(article.category.color);
const categoryRgb = colorRgb(categoryColor);
const headings = getBlogHeadings(article.content);
const articleHtml = renderBlogBlocks(article.content);
const activeLinks = article.links.filter((link) => link.active);
const attachments = article.attachments.filter((attachment) => attachment.url);
const sameCategory = allArticles.filter((candidate) => candidate.id !== article.id && candidate.category.slug === article.category.slug);
const otherArticles = allArticles.filter((candidate) => candidate.id !== article.id && candidate.category.slug !== article.category.slug);
const related = [...sameCategory, ...otherArticles].slice(0, 3);
const articleUrl = `${SITE_URL}/blog/${article.slug}/`;
const socialImage = article.seo?.shareImage?.url || article.coverImage?.url;
const articleImages = [...new Set([article.seo?.shareImage?.url, article.coverImage?.url, DEFAULT_IMAGE].filter(Boolean))];
const seoTitle = blogSeoTitle(article.seo?.metaTitle, `${article.title} | ${settings.publicationName}`);
const seoDescription = blogSeoDescription(article.seo?.metaDescription, article.excerpt);

const dataFooter = {
  title: settings.articleFooterTitle,
  content: settings.articleFooterDescription,
  buttonType: "contacto",
};

const structuredData = [
  {
    "@type": "BlogPosting",
    "@id": `${articleUrl}#article`,
    url: articleUrl,
    headline: article.title,
    description: article.excerpt,
    datePublished: article.publishedDate || article.publishDate,
    dateModified: article.modifiedDate || article.publishDate,
    inLanguage: SITE.language,
    isAccessibleForFree: true,
    articleSection: article.category.name,
    keywords: article.tags.join(", "),
    wordCount: article.content.reduce((count, block) => count + JSON.stringify(block).split(/\s+/).length, 0),
    author: {
      "@type": "Organization",
      name: article.authorName,
      url: `${SITE_URL}/nosotros/`,
    },
    publisher: { "@id": `${SITE_URL}/#organization` },
    isPartOf: { "@id": `${SITE_URL}/blog/#blog` },
    mainEntityOfPage: { "@id": `${articleUrl}#webpage` },
    ...(articleImages.length ? { image: articleImages } : {}),
  },
  {
    "@type": "BreadcrumbList",
    "@id": `${articleUrl}#article-breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE_URL}/blog/` },
      { "@type": "ListItem", position: 3, name: article.title, item: articleUrl },
    ],
  },
];
---

<LayoutNavbar
  dataFooter={dataFooter}
  title={seoTitle}
  description={seoDescription}
  image={socialImage}
  pageType="Article"
  publishedTime={article.publishedDate || article.publishDate}
  modifiedTime={article.modifiedDate || article.publishDate}
  author={article.authorName}
  structuredData={structuredData}
>
  <article class="article-page" style={`--category-color:${categoryColor};--category-rgb:${categoryRgb}`}>
    <header class="article-hero sections">
      <nav class="article-breadcrumb" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/">{settings.publicationName}</a>
        <span aria-hidden="true">/</span>
        <span>{article.category.name}</span>
      </nav>

      <div class="article-hero__heading">
        <div class="article-frequency">
          <span></span>
          {article.category.name}
        </div>
        <h1>{article.title}</h1>
        <p>{article.excerpt}</p>
        <div class="article-byline">
          <span>Por <strong>{article.authorName}</strong></span>
          <span>{formatBlogDate(article.publishDate)}</span>
          <span>{article.readingTime} min de lectura</span>
        </div>
      </div>

      <div class="article-hero__cover">
        <BlogCover article={article} variant="detail" index={1} />
      </div>
    </header>

    <div class="article-layout sections">
      <aside class="article-aside">
        <div class="article-aside__sticky">
          <p>{settings.contentsLabel}</p>
          {headings.length > 0 && (
            <nav aria-label="Contenido del artículo">
              {headings.map((heading, index) => (
                <a href={`#${heading.id}`}>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {heading.label}
                </a>
              ))}
            </nav>
          )}
          <div class="article-aside__category">
            <span class="article-aside__dot"></span>
            <div>
              <strong>{article.category.name}</strong>
              <p>{article.category.description}</p>
            </div>
          </div>
        </div>
      </aside>

      <div class="article-content">
        <div class="article-content__lead">{article.excerpt}</div>
        <div class="article-richtext" set:html={articleHtml}></div>

        {activeLinks.length > 0 && (
          <section class="article-resources" aria-labelledby="article-resources-title">
            <span id="article-resources-title">{settings.resourcesLabel}</span>
            <div>
              {activeLinks.map((link, index) => (
                <a href={link.url} target={link.openInNewTab ? "_blank" : undefined} rel={link.openInNewTab ? "noopener noreferrer" : undefined}>
                  {link.image
                    ? <img src={link.image.url} alt={link.image.alternativeText || link.label} width={link.image.width} height={link.image.height} loading="lazy" decoding="async" />
                    : <b>{String(index + 1).padStart(2, "0")}</b>}
                  <span><strong>{link.label}</strong>{link.description && <small>{link.description}</small>}</span>
                  <i aria-hidden="true">↗</i>
                </a>
              ))}
            </div>
          </section>
        )}

        {attachments.length > 0 && (
          <section class="article-attachments" aria-labelledby="article-attachments-title">
            <span id="article-attachments-title">{settings.attachmentsLabel}</span>
            <div>
              {attachments.map((attachment, index) => (
                <a href={attachment.url} target="_blank" rel="noopener noreferrer">
                  {attachment.mime?.startsWith("image/")
                    ? <img src={attachment.url} alt={attachment.alternativeText || attachment.name || `Archivo ${index + 1}`} width={attachment.width} height={attachment.height} loading="lazy" decoding="async" />
                    : <b aria-hidden="true">{attachment.mime?.split("/").pop()?.slice(0, 4).toUpperCase() || "FILE"}</b>}
                  <span>{attachment.caption || attachment.name || `Archivo ${index + 1}`}</span>
                  <i aria-hidden="true">↓</i>
                </a>
              ))}
            </div>
          </section>
        )}

        {article.tags.length > 0 && (
          <footer class="article-tags">
            <span>{settings.tagsLabel}</span>
            <div>{article.tags.map((tag) => <span>#{tag}</span>)}</div>
          </footer>
        )}
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related-stories sections" aria-labelledby="seguir-leyendo">
      <div class="related-stories__heading">
        <div>
          <p>{settings.relatedEyebrow}</p>
          <h2 id="seguir-leyendo">{settings.relatedTitle}</h2>
        </div>
        <a href="/blog/">{settings.viewAllLabel} <span aria-hidden="true">↗</span></a>
      </div>
      <div class="related-stories__grid">
        {related.map((item, index) => (
          <article style={`--category-color:${safeCategoryColor(item.category.color)};--category-rgb:${colorRgb(item.category.color)}`}>
            <a href={`/blog/${item.slug}/`}>
              <BlogCover article={item} variant="card" index={index + 2} />
              <p>{item.category.name}</p>
              <h3>{item.title}</h3>
              <span>{item.readingTime} min de lectura</span>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}
</LayoutNavbar>

<script>
  const galleryGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-article-gallery]"));
  if (galleryGroups.length) {
    const modal = document.createElement("div");
    modal.className = "article-gallery-modal";
    modal.hidden = true;
    modal.innerHTML = '<header><span data-gallery-count></span><button type="button" data-gallery-close aria-label="Cerrar galería">×</button></header><figure><img data-gallery-main alt="" /><figcaption data-gallery-caption></figcaption></figure><button type="button" class="article-gallery-modal__previous" data-gallery-previous aria-label="Imagen anterior">←</button><button type="button" class="article-gallery-modal__next" data-gallery-next aria-label="Imagen siguiente">→</button>';
    document.body.append(modal);
    const mainImage = modal.querySelector<HTMLImageElement>("[data-gallery-main]")!;
    const caption = modal.querySelector<HTMLElement>("[data-gallery-caption]")!;
    const count = modal.querySelector<HTMLElement>("[data-gallery-count]")!;
    let items: HTMLButtonElement[] = [];
    let current = 0;
    let timer = 0;

    const show = (index: number) => {
      if (!items.length) return;
      current = (index + items.length) % items.length;
      const item = items[current];
      mainImage.src = item.dataset.src || "";
      mainImage.alt = item.dataset.alt || "";
      caption.textContent = item.dataset.caption || "";
      caption.hidden = !caption.textContent;
      count.textContent = `${String(current + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
    };
    const close = () => {
      modal.hidden = true;
      document.body.style.overflow = "";
      if (timer) window.clearInterval(timer);
      timer = 0;
    };
    const open = (group: HTMLElement, index: number) => {
      items = Array.from(group.querySelectorAll<HTMLButtonElement>("[data-article-gallery-image]"));
      show(index);
      modal.hidden = false;
      document.body.style.overflow = "hidden";
      modal.querySelector<HTMLButtonElement>("[data-gallery-close]")?.focus();
      if (group.dataset.autoplay === "true" && items.length > 1) timer = window.setInterval(() => show(current + 1), 5000);
    };
    galleryGroups.forEach((group) => {
      const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>("[data-article-gallery-image]"));
      buttons.forEach((button, index) => button.addEventListener("click", () => open(group, index)));
    });
    modal.querySelector("[data-gallery-close]")?.addEventListener("click", close);
    modal.querySelector("[data-gallery-previous]")?.addEventListener("click", () => show(current - 1));
    modal.querySelector("[data-gallery-next]")?.addEventListener("click", () => show(current + 1));
    modal.addEventListener("click", (event) => { if (event.target === modal) close(); });
    window.addEventListener("keydown", (event) => {
      if (modal.hidden) return;
      if (event.key === "Escape") close();
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });
  }
</script>

<style>
  .article-page {
    --article-max: 1180px;
    position: relative;
  }

  .article-page::before {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 62rem;
    background:
      radial-gradient(circle at 76% 8%, rgb(var(--category-rgb) / 20%), transparent 30%),
      radial-gradient(circle at 8% 26%, rgb(44 170 255 / 12%), transparent 22%);
    content: "";
  }

  .article-hero {
    max-width: var(--article-max);
    margin: 0 auto;
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .article-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: rgb(255 255 255 / 42%);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-breadcrumb a { color: rgb(255 255 255 / 62%); text-decoration: none; }
  .article-breadcrumb a:hover { color: var(--category-color); }
  .article-breadcrumb span:last-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .article-hero__heading {
    max-width: 960px;
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .article-frequency {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--category-color);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .article-frequency span { width: 2rem; height: 1px; background: var(--category-color); box-shadow: 0 0 0.8rem var(--category-color); }

  .article-hero h1 {
    margin-top: 1.4rem;
    color: white;
    font-size: clamp(2.5rem, 7vw, 6.2rem);
    font-weight: 790;
    line-height: 0.98;
    letter-spacing: -0.06em;
    text-wrap: balance;
  }

  .article-hero__heading > p {
    max-width: 740px;
    margin-top: 1.8rem;
    color: rgb(255 255 255 / 66%);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.75;
  }

  .article-byline {
    display: flex;
    margin-top: 1.8rem;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    color: rgb(255 255 255 / 43%);
    font-size: 0.74rem;
  }

  .article-byline strong { color: rgb(255 255 255 / 82%); font-weight: 600; }
  .article-byline span:not(:last-child)::after { margin-left: 1rem; color: var(--category-color); content: "/"; }
  .article-hero__cover { margin-top: clamp(3rem, 7vw, 5.5rem); }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.36fr) minmax(0, 0.64fr);
    gap: clamp(3rem, 8vw, 7rem);
    max-width: 1040px;
    margin: clamp(4rem, 8vw, 7rem) auto 0;
  }

  .article-aside__sticky { position: sticky; top: 8rem; }
  .article-aside__sticky > p { margin-bottom: 1rem; color: rgb(255 255 255 / 34%); font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 0.65rem; letter-spacing: 0.13em; }
  .article-aside nav { display: grid; border-top: 1px solid rgb(255 255 255 / 10%); }
  .article-aside nav a { display: grid; grid-template-columns: 1.55rem 1fr; gap: 0.6rem; padding: 0.8rem 0; border-bottom: 1px solid rgb(255 255 255 / 10%); color: rgb(255 255 255 / 55%); font-size: 0.72rem; line-height: 1.42; text-decoration: none; transition: color 180ms ease; }
  .article-aside nav a:hover { color: white; }
  .article-aside nav a span { color: var(--category-color); font-family: monospace; }
  .article-aside__category { display: flex; margin-top: 2rem; padding: 1rem; gap: 0.8rem; border: 1px solid rgb(var(--category-rgb) / 22%); border-radius: 1rem; background: rgb(var(--category-rgb) / 6%); }
  .article-aside__dot { flex: 0 0 auto; width: 0.55rem; height: 0.55rem; margin-top: 0.3rem; border-radius: 50%; background: var(--category-color); box-shadow: 0 0 0.8rem var(--category-color); }
  .article-aside__category strong { color: white; font-size: 0.76rem; }
  .article-aside__category p { margin-top: 0.45rem; color: rgb(255 255 255 / 46%); font-size: 0.68rem; line-height: 1.55; }

  .article-content { min-width: 0; }
  .article-content__lead { margin-bottom: 2rem; padding-left: 1.4rem; border-left: 2px solid var(--category-color); color: white; font-size: clamp(1.15rem, 2.3vw, 1.45rem); font-weight: 600; line-height: 1.65; }

  .article-richtext :global(p) { margin: 1.15rem 0; color: rgb(255 255 255 / 72%); font-size: 1rem; line-height: 1.9; }
  .article-richtext :global(h2),
  .article-richtext :global(h3),
  .article-richtext :global(h4) { scroll-margin-top: 8rem; color: white; font-weight: 730; line-height: 1.18; letter-spacing: -0.035em; text-wrap: balance; }
  .article-richtext :global(h2) { margin: 3.25rem 0 1.1rem; font-size: clamp(1.75rem, 3.5vw, 2.45rem); }
  .article-richtext :global(h3) { margin: 2.5rem 0 1rem; font-size: 1.55rem; }
  .article-richtext :global(h4) { margin: 2rem 0 0.8rem; font-size: 1.25rem; }
  .article-richtext :global(strong) { color: white; font-weight: 700; }
  .article-richtext :global(.article-align--center) { text-align: center; }
  .article-richtext :global(.article-align--right) { text-align: right; }
  .article-richtext :global(a) { color: var(--category-color); text-decoration-thickness: 1px; text-underline-offset: 0.25rem; }
  .article-richtext :global(ul),
  .article-richtext :global(ol) { display: grid; margin: 1.5rem 0; padding-left: 1.4rem; gap: 0.75rem; color: rgb(255 255 255 / 70%); }
  .article-richtext :global(li) { padding-left: 0.4rem; line-height: 1.7; }
  .article-richtext :global(li::marker) { color: var(--category-color); }
  .article-richtext :global(blockquote) { position: relative; margin: 2.6rem 0; padding: 1.6rem 1.75rem 1.6rem 2.2rem; border: 1px solid rgb(var(--category-rgb) / 28%); border-radius: 1.2rem; color: white; background: linear-gradient(135deg, rgb(var(--category-rgb) / 12%), rgb(7 16 43 / 62%)); font-size: clamp(1.12rem, 2.4vw, 1.4rem); font-weight: 600; line-height: 1.6; }
  .article-richtext :global(blockquote::before) { position: absolute; top: 1.3rem; left: -0.45rem; color: var(--category-color); font-size: 2.4rem; line-height: 1; content: "“"; text-shadow: 0 0 1rem var(--category-color); }
  .article-richtext :global(pre) { margin: 1.75rem 0; padding: 1.25rem; overflow-x: auto; border: 1px solid rgb(87 187 255 / 20%); border-radius: 1rem; background: #04091b; color: #bde8ff; }
  .article-richtext :global(code) { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
  .article-richtext :global(figure) { margin: 2.5rem 0; }
  .article-richtext :global(.article-inline-image) { display: block; width: 100%; height: auto; max-height: min(72vh, 54rem); border: 1px solid rgb(var(--category-rgb) / 30%); border-radius: 1.3rem; background: rgb(3 10 35 / 74%); box-shadow: 0 1.4rem 3.5rem rgb(0 0 28 / 24%); object-fit: contain; }
  .article-richtext :global(figcaption) { margin-top: 0.7rem; color: rgb(255 255 255 / 44%); font-size: 0.72rem; text-align: center; }
  .article-richtext :global(.article-image--full) { width: min(100vw - 2.25rem, 1050px); margin-left: 50%; transform: translateX(-50%); }
  .article-richtext :global(.article-image--left),
  .article-richtext :global(.article-image--right) { width: min(48%, 22rem); }
  .article-richtext :global(.article-image--left) { float: left; margin: 0.6rem 1.4rem 1rem 0; }
  .article-richtext :global(.article-image--right) { float: right; margin: 0.6rem 0 1rem 1.4rem; }
  .article-richtext :global(.article-image--left .article-inline-image),
  .article-richtext :global(.article-image--right .article-inline-image) { max-height: 28rem; }
  .article-richtext :global(.article-callout) { --callout: var(--category-color); margin: 2rem 0; padding: 1.25rem 1.4rem; border: 1px solid color-mix(in srgb, var(--callout) 32%, transparent); border-radius: 1rem; background: color-mix(in srgb, var(--callout) 8%, rgb(7 16 43 / 72%)); }
  .article-richtext :global(.article-callout--success) { --callout: #00d9a4; }
  .article-richtext :global(.article-callout--warning) { --callout: #ffbd59; }
  .article-richtext :global(.article-callout--note) { --callout: #b997ff; }
  .article-richtext :global(.article-callout strong) { display: block; margin-bottom: 0.35rem; color: var(--callout); font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .article-richtext :global(.article-callout p) { margin: 0; }
  .article-richtext :global(.article-inline-cta) { margin: 2rem 0; }
  .article-richtext :global(.article-inline-cta a) { display: inline-flex; min-height: 3rem; padding: 0.75rem 1.1rem; align-items: center; gap: 1rem; border: 1px solid rgb(var(--category-rgb) / 38%); border-radius: 0.85rem; color: white; background: rgb(var(--category-rgb) / 12%); font-weight: 700; text-decoration: none; }
  .article-richtext :global(.article-inline-cta--primary) { background: var(--category-color); color: #031326 !important; }
  .article-richtext :global(.article-video) { margin: 2.5rem 0; }
  .article-richtext :global(.article-video > div) { position: relative; padding-top: 56.25%; overflow: hidden; border: 1px solid rgb(var(--category-rgb) / 28%); border-radius: 1.2rem; background: #020617; }
  .article-richtext :global(.article-video iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .article-richtext :global(.article-video video) { width: 100%; border-radius: 1.2rem; background: #020617; }
  .article-richtext :global(.article-embed) { display: flex; margin: 2rem 0; padding: 1.1rem 1.25rem; align-items: center; gap: 1rem; border: 1px solid rgb(var(--category-rgb) / 24%); border-radius: 1rem; background: rgb(255 255 255 / 3%); }
  .article-richtext :global(.article-embed > span) { color: var(--category-color); font: 700 0.62rem/1 monospace; letter-spacing: 0.12em; }
  .article-richtext :global(.article-embed > div) { display: grid; gap: 0.35rem; }
  .article-richtext :global(.article-embed a) { width: fit-content; font-size: 0.75rem; }
  .article-richtext :global(.article-table) { margin: 2.5rem 0; }
  .article-richtext :global(.article-table > div) { overflow-x: auto; border: 1px solid rgb(var(--category-rgb) / 24%); border-radius: 1rem; }
  .article-richtext :global(table) { width: 100%; min-width: 34rem; border-collapse: collapse; }
  .article-richtext :global(th), .article-richtext :global(td) { padding: 0.85rem 1rem; border-bottom: 1px solid rgb(255 255 255 / 9%); color: rgb(255 255 255 / 68%); font-size: 0.78rem; text-align: left; }
  .article-richtext :global(th) { color: white; background: rgb(var(--category-rgb) / 12%); }
  .article-richtext :global(.article-divider) { height: 1px; margin: 3rem 0; border: 0; background: linear-gradient(90deg, transparent, var(--category-color), transparent); opacity: 0.55; }
  .article-richtext :global(.article-gallery) { width: min(100vw - 2.25rem, 980px); margin: 3rem 0 3rem 50%; transform: translateX(-50%); }
  .article-richtext :global(.article-gallery > h3) { margin: 0 0 1rem; font-size: clamp(1.4rem, 3vw, 2rem); }
  .article-richtext :global(.article-gallery > div) { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .65rem; }
  .article-richtext :global(.article-gallery--masonry > div) { align-items: start; }
  .article-richtext :global(.article-gallery--carousel > div) { display: flex; padding-bottom: .55rem; scroll-snap-type: x mandatory; overflow-x: auto; }
