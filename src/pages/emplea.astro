---
import LayoutNavbar from "../layouts/LayoutNavbar.astro";
import Intro from "../components/emplea/intro.astro";
import Talent from "../components/emplea/talent.astro";
import ChatWithUs from "~/components/emplea/chatWithUs.astro";
import AlliedCompanies from "../components/alliedCompanies.astro";
import ConnectingTalent from "../components/emplea/connectingTalent.astro";
import "~/styles/index.css";

const dataFooter = {
  title: "¿Listo para potenciar tu empresa con talento tech de alto nivel?",
  content:
    "Da el siguiente paso en la innovación de tu equipo. Descubre cómo nuestros Campers, formados en desarrollo, inglés y habilidades blandas, pueden impulsar el crecimiento de tu empresa. ¡Contrata talento preparado para los retos del futuro!",
  buttonType: "emplear",
  buttonIcon: "arm.svg",
};
---

<LayoutNavbar
  dataFooter={dataFooter}
  structuredData={{
    "@type": "Service",
    "@id": "https://www.campuslands.pro/emplea/#servicio",
    name: "Conexión con talento tecnológico en Guatemala",
    description:
      "Conectamos empresas con jóvenes formados en desarrollo de software, inglés y habilidades profesionales.",
    url: "https://www.campuslands.pro/emplea/",
    provider: { "@id": "https://www.campuslands.pro/#organization" },
    areaServed: { "@type": "Country", name: "Guatemala" },
    serviceType: "Conexión de empresas con talento tecnológico",
  }}
>
  <Intro />
  <Talent />
  <ChatWithUs />
  <AlliedCompanies />
  <ConnectingTalent />
</LayoutNavbar>
