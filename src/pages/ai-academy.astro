---
import { Image } from "astro:assets";
import LayoutNavbar from "../layouts/LayoutNavbar.astro";
import orbitAI from "../assets/img/ai-academy/orbit-ai-academy.png";
import { SITE_URL } from "../config/seo.mjs";
import "~/styles/index.css";

const whatsappMessage = encodeURIComponent(
  "¡Hola! Me interesan los talleres de AI Academy de Campuslands Guatemala. ¿Podrían compartirme fechas, disponibilidad y costos?",
);
const whatsappUrl = `https://wa.me/50232705200?text=${whatsappMessage}`;

const workshops = [
  {
    id: "automatizaciones",
    code: "AUTO.01",
    title: "Automatizaciones con IA",
    promise:
      "Convierte tareas repetitivas en flujos que trabajan contigo y dejan tiempo para decisiones de mayor valor.",
    audience:
      "Emprendedores, estudiantes y equipos administrativos, comerciales u operativos.",
    tools: ["Make", "n8n", "Zapier", "IA generativa"],
    sessions: [
      {
        title: "Detecta oportunidades",
        description:
          "Mapea procesos, identifica cuellos de botella y crea un kit de prompts para la operación diaria.",
        output: "Mapa de proceso + SOP",
      },
      {
        title: "Conecta sin código",
        description:
          "Integra formularios, hojas de cálculo, correo, Notion, Airtable y mensajería.",
        output: "3 automatizaciones diseñadas",
      },
      {
        title: "Activa la inteligencia",
        description:
          "Clasifica información, resume documentos y genera reportes con salidas estructuradas.",
        output: "Flujo con IA validado",
      },
      {
        title: "Lanza tu sistema",
        description:
          "Construye, prueba y presenta una automatización completa con control humano y manejo de errores.",
        output: "Automatización funcional",
      },
    ],
    final:
      "Una automatización implementada, checklist de validación y presentación ejecutiva.",
  },
  {
    id: "datos",
    code: "DATA.02",
    title: "Análisis de Datos con IA",
    promise:
      "Pasa de datos dispersos a hallazgos confiables, visualizaciones claras y decisiones accionables.",
    audience:
      "Analistas y equipos de negocio, operaciones, ventas, finanzas o marketing.",
    tools: ["Copilot", "Excel", "KPIs", "Storytelling"],
    sessions: [
      {
        title: "Pregunta y prepara",
        description:
          "Define la pregunta de negocio, limpia datos y establece criterios de validación.",
        output: "Dataset listo para analizar",
      },
      {
        title: "Encuentra patrones",
        description:
          "Explora tendencias, formula hipótesis y convierte hallazgos en visualizaciones comprensibles.",
        output: "Resumen de insights",
      },
      {
        title: "Diseña KPIs",
        description:
          "Construye métricas útiles y un flujo de análisis reutilizable con Copilot.",
        output: "Sistema de KPIs",
      },
      {
        title: "Influye con evidencia",
        description:
          "Crea una narrativa ejecutiva y un sistema de decisión que conecte insight, acción y seguimiento.",
        output: "Blueprint de decisión",
      },
    ],
    final:
      "Un flujo de análisis reproducible con KPIs, visualización y narrativa ejecutiva.",
  },
  {
    id: "marketing",
    code: "MKT.03",
    title: "Marketing con IA",
    promise:
      "Construye un sistema de marketing que investiga, crea, distribuye y aprende con mayor velocidad.",
    audience:
      "Emprendedores, estudiantes, creadores de contenido y equipos comerciales.",
    tools: ["Prompts", "Automatización", "Agentes", "Contenido"],
    sessions: [
      {
        title: "Entiende la marca",
        description:
          "Domina prompts, analiza la marca, define buyer personas y compara competidores.",
        output: "Diagnóstico de marca",
      },
      {
        title: "Crea con dirección",
        description:
          "Genera ideas, hooks, copies, guiones y un calendario editorial de 30 días.",
        output: "Sistema de contenidos",
      },
      {
        title: "Convierte atención",
        description:
          "Define propuesta de valor, funnel, anuncios y secuencias para WhatsApp o mensajes directos.",
        output: "Campaña de 7 días",
      },
      {
        title: "Mide y escala",
        description:
          "Reutiliza contenido, analiza métricas y consolida una biblioteca de prompts para la marca.",
        output: "Plan de marketing de 30 días",
      },
    ],
    final:
      "Un sistema de marketing para una marca: estrategia, contenido, campaña y medición.",
  },
  {
    id: "finanzas",
    code: "FIN.04",
    title: "Finanzas con IA",
    promise:
      "Lleva finanzas de la operación transaccional a una función estratégica que recomienda y decide.",
    audience:
      "Profesionales de finanzas, contabilidad, administración, planeación y negocio.",
    tools: ["IA generativa", "Excel", "Escenarios", "KPIs"],
    sessions: [
      {
        title: "Mapea el valor",
        description:
          "Identifica oportunidades de IA en flujos financieros y prioriza por impacto, riesgo y trazabilidad.",
        output: "Mapa estratégico de IA",
      },
      {
        title: "Ordena y reporta",
        description:
          "Estructura datos y transforma reportes financieros en información ejecutiva.",
        output: "Reporte financiero optimizado",
      },
      {
        title: "Anticipa escenarios",
        description:
          "Modela escenarios, analiza variaciones y rediseña procesos financieros críticos.",
        output: "Modelo de escenarios",
      },
      {
        title: "Decide e influye",
        description:
          "Conecta KPIs, recomendaciones y narrativa ejecutiva en un marco de decisión financiera.",
        output: "Framework de decisión",
      },
    ],
    final:
      "Un blueprint financiero con procesos, escenarios, KPIs y narrativa para dirección.",
  },
];

const faqs = [
  {
    question: "¿Necesito experiencia previa usando inteligencia artificial?",
    answer:
      "No. Los talleres parten de fundamentos prácticos y avanzan mediante ejercicios guiados. Sí ayuda sentir curiosidad, estar dispuesto a experimentar y conocer lo básico de tu área de interés.",
  },
  {
    question: "¿Necesito saber programar?",
    answer:
      "No para los talleres iniciales. Automatizaciones se trabaja principalmente con herramientas no-code y los demás talleres se enfocan en aplicar IA a situaciones reales de negocio.",
  },
  {
    question: "¿Cómo se distribuyen las 16 horas?",
    answer:
      "Cada taller se desarrolla en cuatro sábados consecutivos, con una sesión de cuatro horas por sábado. En cada encuentro se construye una parte del proyecto final.",
  },
  {
    question: "¿Los talleres son presenciales?",
    answer:
      "La propuesta publicada de AI Academy es presencial en Campuslands Guatemala, dentro de Campus Tec, Zona 4. Confirma la cohorte y el horario disponibles con nuestro equipo.",
  },
  {
    question: "¿Qué debo llevar?",
    answer:
      "Una computadora portátil y acceso a las cuentas o herramientas indicadas antes de iniciar. Los requisitos específicos pueden variar según el taller.",
  },
  {
    question: "¿Las herramientas de IA están incluidas?",
    answer:
      "Algunas ofrecen planes gratuitos y otras pueden requerir una cuenta o licencia. Antes de cada cohorte te compartiremos la lista vigente para que puedas prepararte.",
  },
  {
    question: "¿Con qué termino el taller?",
    answer:
      "Terminas con un proyecto aplicado a tu realidad: una automatización, un sistema de análisis, un sistema de marketing o un blueprint financiero, según el taller elegido.",
  },
  {
    question: "¿Cuándo inicia la próxima cohorte y cuál es el costo?",
    answer:
      "Las fechas, cupos y costos se confirman directamente con el equipo de Campuslands Guatemala. Escríbenos por WhatsApp y te compartiremos la información vigente.",
  },
];

const dataFooter = {
  title: "Tu próximo sábado puede cambiar cómo trabajas toda la semana.",
  content:
    "Cuéntanos qué quieres transformar y te ayudaremos a elegir el taller de IA que mejor conecta con tu objetivo.",
  buttonType: "ia",
  buttonLink: whatsappUrl,
};

const structuredData = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/ai-academy/#talleres`,
    name: "Talleres de AI Academy de Campuslands Guatemala",
    itemListElement: workshops.map((workshop, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Course",
        "@id": `${SITE_URL}/ai-academy/#${workshop.id}`,
        name: `Taller de ${workshop.title}`,
        description: workshop.promise,
        url: `${SITE_URL}/ai-academy/#${workshop.id}`,
        inLanguage: "es-GT",
        timeRequired: "PT16H",
        educationalLevel: "Introductorio a intermedio",
        provider: { "@id": `${SITE_URL}/#organization` },
        hasCourseInstance: {
          "@type": "CourseInstance",
          courseMode: "Presencial",
          courseWorkload: "PT16H",
          location: {
            "@type": "Place",
            name: "Campuslands Guatemala",
            address: "Campus Tec, Zona 4, Ciudad de Guatemala",
          },
        },
      },
    })),
  },
  {
    "@type": "FAQPage",
    "@id": `${SITE_URL}/ai-academy/#preguntas`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<LayoutNavbar
  dataFooter={dataFooter}
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="ai-page">
    <section class="ai-hero" aria-labelledby="ai-hero-title">
      <div class="ai-hero__grid" aria-hidden="true"></div>
      <div class="ai-shell ai-hero__layout">
        <div class="ai-hero__copy">
          <p class="ai-kicker">
            <span></span>
            AI Academy · Campuslands Guatemala
          </p>
          <h1 id="ai-hero-title">
            Aprende IA.
            <span>Construye algo real.</span>
          </h1>
          <p class="ai-hero__lead">
            Cuatro talleres presenciales para aplicar inteligencia artificial
            a automatización, datos, marketing y finanzas. Menos teoría
            decorativa. Más sistemas que puedes usar desde el lunes.
          </p>
          <div class="ai-actions">
            <a class="ai-button ai-button--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              Quiero información
              <span aria-hidden="true">↗</span>
            </a>
            <a class="ai-button ai-button--ghost" href="#talleres">
              Explorar talleres
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <dl class="ai-metrics" aria-label="Formato de AI Academy">
            <div>
              <dt>04</dt>
              <dd>sábados</dd>
            </div>
            <div>
              <dt>16</dt>
              <dd>horas</dd>
            </div>
            <div>
              <dt>04</dt>
              <dd>talleres</dd>
            </div>
          </dl>
        </div>

        <figure class="ai-orbit" data-ai-orbit>
          <div class="ai-orbit__halo" aria-hidden="true"></div>
          <div class="ai-orbit__ring ai-orbit__ring--outer" aria-hidden="true"></div>
          <div class="ai-orbit__ring ai-orbit__ring--inner" aria-hidden="true"></div>
          <span class="ai-orbit__signal ai-orbit__signal--one" aria-hidden="true"></span>
          <span class="ai-orbit__signal ai-orbit__signal--two" aria-hidden="true"></span>
          <Image
            src={orbitAI}
            alt="Orbit, astronauta de Campuslands, conectado a una red de inteligencia artificial azul y morada"
            format="webp"
            widths={[480, 720, 960]}
            sizes="(max-width: 767px) 92vw, (max-width: 1200px) 48vw, 620px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <span>ORBIT_AI</span>
            Señal detectada · aprendizaje aplicado
          </figcaption>
        </figure>
      </div>
      <a class="ai-scroll-cue" href="#talleres">
        <span aria-hidden="true"></span>
        Desplázate para iniciar
      </a>
    </section>

    <section class="ai-manifesto" aria-labelledby="ai-manifesto-title" data-ai-reveal>
      <div class="ai-shell ai-manifesto__layout">
        <p class="ai-section-code" aria-hidden="true">01 / CAMBIA EL MÉTODO</p>
        <div>
          <h2 id="ai-manifesto-title">
            La IA no se aprende mirando.
            <span>Se aprende haciendo.</span>
          </h2>
          <p>
            Cada sábado convierte una pregunta real en un entregable. Aprendes
            el criterio para pedir, revisar y mejorar el trabajo de la IA; no
            una colección de trucos que caducan.
          </p>
        </div>
        <div class="ai-manifesto__signal" aria-label="Principio de aprendizaje">
          <span>Prompt</span>
          <i aria-hidden="true"></i>
          <span>Prototipo</span>
          <i aria-hidden="true"></i>
          <strong>Resultado</strong>
        </div>
      </div>
    </section>

    <section class="ai-workshops" id="talleres" aria-labelledby="ai-workshops-title">
      <div class="ai-shell">
        <div class="ai-section-head" data-ai-reveal>
          <div>
            <p class="ai-section-code">02 / ELIGE TU MISIÓN</p>
            <h2 id="ai-workshops-title">Cuatro rutas. Un resultado usable.</h2>
          </div>
          <div class="ai-section-head__aside">
            <p>
              Arrastra, desliza o usa los controles para recorrer los talleres.
            </p>
            <div class="ai-track-controls" aria-label="Controles del catálogo">
              <button type="button" data-ai-track-prev aria-label="Ver taller anterior">
                ←
              </button>
              <span data-ai-track-count aria-live="polite">01 / 04</span>
              <button type="button" data-ai-track-next aria-label="Ver taller siguiente">
                →
