interface WorkshopConfigItem {
  isOpen: boolean;
  startDate: string;
  curriculumUrl: string;
}

const defaultWorkshopConfig: Record<string, WorkshopConfigItem> = {
  "ia-cero-agentes": {
    isOpen: true,
    startDate: "24 de octubre",
    curriculumUrl: "",
  },
  marketing: {
    isOpen: false,
    startDate: "Próximamente",
    curriculumUrl: "",
  },
  finanzas: {
    isOpen: false,
    startDate: "Próximamente",
    curriculumUrl: "",
  },
  datos: {
    isOpen: false,
    startDate: "Próximamente",
    curriculumUrl: "",
  },
  automatizaciones: {
    isOpen: false,
    startDate: "Próximamente",
    curriculumUrl: "",
  },
};

let liveAcademyConfig: Record<string, WorkshopConfigItem> = { ...defaultWorkshopConfig };
try {
  const academyConfigFilePath = path.resolve(process.cwd(), "data/ai-academy-config.json");
  if (fs.existsSync(academyConfigFilePath)) {
    const rawData = fs.readFileSync(academyConfigFilePath, "utf-8");
    const parsedData = JSON.parse(rawData);
    liveAcademyConfig = { ...defaultWorkshopConfig, ...parsedData };
  }
} catch (configError) {
  console.warn("No se pudo leer data/ai-academy-config.json:", configError);
}

const activeWorkshops = workshops.map((workshop) => {
  const dynamicCfg = liveAcademyConfig[workshop.id] || {
    isOpen: false,
    startDate: "",
    curriculumUrl: "",
  };

  const formattedStartDate = dynamicCfg.startDate || (workshop.cohort ? workshop.cohort.replace(/^INICIA\s+/i, "") : "");

  return {
    ...workshop,
    isOpen: Boolean(dynamicCfg.isOpen),
    startDate: formattedStartDate,
    curriculumUrl: dynamicCfg.curriculumUrl || "",
  };
});

const faqs = [
  {
    question: "¿Necesito experiencia previa usando inteligencia artificial?",
    answer:
      "No. Los talleres parten de fundamentos prácticos y avanzan mediante ejercicios guiados. No necesitas saber programación ni tener experiencia previa, solamente curiosidad y ganas de experimentar con situaciones reales.",
  },
  {
    question: "¿Necesito saber programar?",
    answer:
      "No. No necesitas saber programación ni tener experiencia previa. Talleres como 'IA de cero a Agentes' y 'Automatizaciones IA' parten desde los fundamentos prácticos, configuración y herramientas no-code para aplicar la inteligencia artificial a tus metas.",
  },
  {
    question: "¿Cómo se distribuyen las 16 horas?",
    answer:
      "Cada taller se desarrolla en cuatro sesiones de 4 horas (16 horas en total), combinando un 50% de fundamentos y método con un 50% de práctica individual donde construyes tu proyecto paso a paso.",
  },
  {
    question: "¿Los talleres son presenciales?",
    answer:
      "La propuesta publicada de AI Academy es presencial en Campuslands Guatemala, dentro de Campus Tec, Zona 4. Confirma la cohorte y el horario disponibles con nuestro equipo.",
  },
  {
    question: "¿Qué debo llevar?",
    answer:
      "Una computadora portátil y acceso a las cuentas o herramientas indicadas antes de iniciar. Los requisitos específicos pueden variar según el taller.",
  },
  {
    question: "¿Las herramientas de IA están incluidas?",
    answer:
      "Algunas ofrecen planes gratuitos y otras pueden requerir suscripción activa. Para el taller 'IA de cero a Agentes', la clase de creación de Skills requiere una cuenta de pago en ChatGPT, Claude o Gemini. Antes de cada cohorte te compartiremos la lista detallada para que puedas prepararte.",
  },
  {
    question: "¿Con qué termino el taller?",
    answer:
      "Terminas con un proyecto aplicado a tu realidad: un agente coordinador con subagentes y biblioteca de prompts, un sistema de marketing, un blueprint financiero, un análisis de datos o una automatización funcional, según el taller elegido.",
  },
  {
    question: "¿Cuándo inicia la próxima cohorte y cuál es el costo?",
    answer:
      "Iniciamos el 24 de octubre. Las fechas, cupos y costos se confirman directamente con el equipo de Campuslands Guatemala. Escribe 'IA' por mensaje directo o WhatsApp para recibir la información de inscripción y consultar las opciones de pago con tarjeta.",
  },
];

const dataFooter = {
  title: "Tu próximo sábado puede cambiar cómo trabajas toda la semana.",
  content:
    "Cuéntanos qué quieres transformar y te ayudaremos a elegir el taller de IA que mejor conecta con tu objetivo.",
  buttonType: "ia",
  buttonLink: whatsappUrl,
};

const structuredData = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/ai-academy/#talleres`,
    name: "Talleres de AI Academy de Campuslands Guatemala",
    itemListElement: activeWorkshops.map((workshop, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Course",
        "@id": `${SITE_URL}/ai-academy/#${workshop.id}`,
        name: workshop.fullName || `Taller de ${workshop.title}`,
        description: workshop.promise,
        url: `${SITE_URL}/ai-academy/#${workshop.id}`,
        inLanguage: "es-GT",
        timeRequired: "PT16H",
        educationalLevel: "Introductorio a intermedio",
        provider: { "@id": `${SITE_URL}/#organization` },
        hasCourseInstance: {
          "@type": "CourseInstance",
          courseMode: "Presencial",
          courseWorkload: "PT16H",
          location: {
            "@type": "Place",
            name: "Campuslands Guatemala",
            address: "Campus Tec, Zona 4, Ciudad de Guatemala",
          },
        },
      },
    })),
  },
  {
    "@type": "FAQPage",
    "@id": `${SITE_URL}/ai-academy/#preguntas`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<LayoutNavbar
  dataFooter={dataFooter}
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="ai-page">
    <section class="ai-hero" aria-labelledby="ai-hero-title">
      <div class="ai-hero__grid" aria-hidden="true"></div>
      <div class="ai-shell ai-hero__layout">
        <div class="ai-hero__copy">
          <p class="ai-kicker">
            <span></span>
            AI Academy · Campuslands Guatemala
          </p>
          <h1 id="ai-hero-title">
            Aprende IA.
            <span>Construye algo real.</span>
          </h1>
          <p class="ai-hero__lead">
            Cinco talleres presenciales para aplicar inteligencia artificial a
            fundamentos y agentes, marketing, finanzas, análisis de datos y
            automatización. Menos teoría y más manos a la obra para aprender. Convierte
            la IA en sistemas que puedes usar en tu profesión.
          </p>
          <div class="ai-actions">
            <a class="ai-button ai-button--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              Quiero información
              <span aria-hidden="true">↗</span>
            </a>
            <a class="ai-button ai-button--ghost" href="#talleres">
              Explorar talleres
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <dl class="ai-metrics" aria-label="Formato de AI Academy">
            <div>
              <dt>04</dt>
              <dd>sábados</dd>
            </div>
            <div>
              <dt>16</dt>
              <dd>horas</dd>
            </div>
            <div class="ai-metrics__workshops">
              <dt>05</dt>
              <dd>
                <span>talleres</span>
                <strong>distintos</strong>
              </dd>
            </div>
          </dl>
          <p class="ai-metrics__note">
            <span class="ai-metrics__note-icon" aria-hidden="true">↳</span>
            <span>
              Elige tu ruta: cada taller es independiente y dura
              <strong>4 sábados · 16 horas.</strong>
            </span>
          </p>
        </div>

        <figure class="ai-orbit" data-ai-orbit>
          <div class="ai-orbit__halo" aria-hidden="true"></div>
          <div class="ai-orbit__ring ai-orbit__ring--outer" aria-hidden="true"></div>
          <div class="ai-orbit__ring ai-orbit__ring--inner" aria-hidden="true"></div>
          <span class="ai-orbit__signal ai-orbit__signal--one" aria-hidden="true"></span>
          <span class="ai-orbit__signal ai-orbit__signal--two" aria-hidden="true"></span>
          <Image
            src={orbitAI}
            alt="Orbit, astronauta de Campuslands, conectado a una red de inteligencia artificial azul y morada"
            format="avif"
            widths={[240, 360, 480, 720, 960]}
            sizes="(max-width: 719px) 64vw, (max-width: 1200px) 48vw, 620px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <span>ORBIT_AI</span>
            Señal detectada · aprendizaje aplicado
          </figcaption>
        </figure>
      </div>
      <a class="ai-scroll-cue" href="#talleres">
        <span aria-hidden="true"></span>
        Desplázate para iniciar
      </a>
    </section>

    <section class="ai-manifesto" aria-labelledby="ai-manifesto-title" data-ai-reveal>
      <div class="ai-shell ai-manifesto__layout">
        <p class="ai-section-code" aria-hidden="true">01 / CAMBIA EL MÉTODO</p>
        <div>
          <h2 id="ai-manifesto-title">
            La IA no se aprende mirando.
            <span>Se aprende haciendo.</span>
          </h2>
          <p>
            Cada sábado convierte una pregunta real en un entregable. Aprendes
            el criterio para pedir, revisar y mejorar el trabajo de la IA; no
            una colección de trucos que caducan.
          </p>
        </div>
        <div class="ai-manifesto__signal" aria-label="Principio de aprendizaje">
          <span>Prompt</span>
          <i aria-hidden="true"></i>
          <span>Prototipo</span>
          <i aria-hidden="true"></i>
          <strong>Resultado</strong>
        </div>
      </div>
    </section>

    <section class="ai-workshops" id="talleres" aria-labelledby="ai-workshops-title">
      <div class="ai-shell">
        <div class="ai-section-head" data-ai-reveal>
          <div>
            <p class="ai-section-code">02 / ELIGE TU MISIÓN</p>
            <h2 id="ai-workshops-title">Cinco rutas. Un resultado aplicable.</h2>
          </div>
          <div class="ai-section-head__aside">
            <p>
              Arrastra, desliza o usa los controles para recorrer los talleres.
            </p>
            <div class="ai-track-controls" aria-label="Controles del catálogo">
              <button type="button" data-ai-track-prev aria-label="Ver taller anterior">
                ←
              </button>
              <span data-ai-track-count aria-live="polite">01 / 05</span>
              <button type="button" data-ai-track-next aria-label="Ver taller siguiente">
                →
              </button>
            </div>
          </div>
        </div>
      </div>

      <div
        class="ai-workshop-track"
        data-ai-workshop-track
        tabindex="0"
        aria-label="Catálogo horizontal de talleres"
      >
        {
          activeWorkshops.map((workshop, workshopIndex) => (
            <article
              class:list={[
                "ai-workshop-card",
                workshop.isOpen ? "ai-workshop-card--open" : "ai-workshop-card--upcoming"
              ]}
              id={workshop.id}
              data-ai-workshop-card
              data-workshop-id={workshop.id}
              data-workshop-open={workshop.isOpen ? "true" : "false"}
              aria-labelledby={`workshop-${workshop.id}`}
            >
              <div class="ai-workshop-card__top">
                <div class="ai-workshop-card__top-lead">
                  <p class="ai-workshop-card__code">{workshop.code}</p>
                  <span
                    class:list={[
                      "ai-status-pill",
                      workshop.isOpen ? "ai-status-pill--open" : "ai-status-pill--upcoming"
                    ]}
                    data-status-pill
                  >
                    <span class="ai-status-pill__dot" aria-hidden="true"></span>
                    <span data-status-text>{workshop.isOpen ? "Inscripciones abiertas" : "Próximamente"}</span>
                  </span>
                </div>

                <div class="ai-workshop-card__top-meta">
                  {workshop.startDate ? (
                    <span class="ai-workshop-card__date" data-date-pill>
                      <svg class="ai-icon-cal" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      <strong class="ai-date-label">Inicia:</strong>
                      <span data-date-text>{workshop.startDate}</span>
                    </span>
                  ) : null}
                  <span class="ai-workshop-card__format-tag">
                    16H · PRESENCIAL
                  </span>
                </div>
              </div>

              <div class="ai-workshop-card__intro">
                <div>
                  <span class="ai-workshop-card__number" aria-hidden="true">
                    {String(workshopIndex + 1).padStart(2, "0")}
                  </span>
                  <h3 id={`workshop-${workshop.id}`}>
                    {workshop.eyebrow && (
                      <span class="ai-workshop-card__eyebrow">{workshop.eyebrow}</span>
                    )}
                    {workshop.title}
                  </h3>
                </div>
                <p>{workshop.promise}</p>
              </div>

              <div class="ai-workshop-card__meta">
                <p><span>Ideal para</span>{workshop.audience}</p>
                <ul aria-label="Herramientas y enfoques">
                  {workshop.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </div>

              <ol class="ai-session-grid" aria-label="Ruta de cuatro sábados">
                {workshop.sessions.map((session, sessionIndex) => (
                  <li>
                    <div class="ai-session-grid__index">
                      <span>S{sessionIndex + 1}</span>
                      <i aria-hidden="true"></i>
                    </div>
                    <h4>{session.title}</h4>
                    <p>{session.description}</p>
                    <strong>{session.output}</strong>
                  </li>
                ))}
              </ol>

              <div class="ai-workshop-card__final">
                <p><span>Proyecto final</span>{workshop.final}</p>
                <div class="ai-workshop-card__actions">
                  <button
                    type="button"
                    class="ai-btn-curriculum"
                    data-ai-curriculum-trigger
                    data-workshop-id={workshop.id}
                    data-curriculum-url={workshop.curriculumUrl}
                    data-workshop-title={workshop.fullName || workshop.title}
                    title="Ver malla curricular completa del taller"
                  >
                    <svg class="ai-icon-doc" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Ver malla curricular</span>
