              data-ai-workshop-card
              aria-labelledby={`workshop-${workshop.id}`}
            >
              <div class="ai-workshop-card__top">
                <p>{workshop.code}</p>
                <span>16H · PRESENCIAL</span>
              </div>
              <div class="ai-workshop-card__intro">
                <div>
                  <span class="ai-workshop-card__number" aria-hidden="true">
                    {String(workshopIndex + 1).padStart(2, "0")}
                  </span>
                  <h3 id={`workshop-${workshop.id}`}>{workshop.title}</h3>
                </div>
                <p>{workshop.promise}</p>
              </div>

              <div class="ai-workshop-card__meta">
                <p><span>Ideal para</span>{workshop.audience}</p>
                <ul aria-label="Herramientas y enfoques">
                  {workshop.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </div>

              <ol class="ai-session-grid" aria-label="Ruta de cuatro sábados">
                {workshop.sessions.map((session, sessionIndex) => (
                  <li>
                    <div class="ai-session-grid__index">
                      <span>S{sessionIndex + 1}</span>
                      <i aria-hidden="true"></i>
                    </div>
                    <h4>{session.title}</h4>
                    <p>{session.description}</p>
                    <strong>{session.output}</strong>
                  </li>
                ))}
              </ol>

              <div class="ai-workshop-card__final">
                <p><span>Proyecto final</span>{workshop.final}</p>
                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">
                  Consultar este taller <span aria-hidden="true">↗</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <div class="ai-track-progress" aria-hidden="true">
        <span data-ai-track-progress></span>
      </div>
    </section>

    <section class="ai-format" aria-labelledby="ai-format-title">
      <div class="ai-shell">
        <div class="ai-section-head" data-ai-reveal>
          <div>
            <p class="ai-section-code">03 / CUATRO SÁBADOS</p>
            <h2 id="ai-format-title">Una idea por semana. Un sistema al final.</h2>
          </div>
          <p class="ai-section-head__copy">
            La experiencia avanza como un sprint: entender, construir, validar y
            presentar. Cada bloque de cuatro horas deja evidencia de progreso.
          </p>
        </div>

        <ol class="ai-timeline" data-ai-reveal>
          <li>
            <div><span>01</span><small>4 horas</small></div>
            <h3>Entiende</h3>
            <p>Define el problema, el contexto y el estándar de una buena respuesta.</p>
          </li>
          <li>
            <div><span>02</span><small>8 horas</small></div>
            <h3>Construye</h3>
            <p>Convierte el método en prompts, flujos, análisis o activos concretos.</p>
          </li>
          <li>
            <div><span>03</span><small>12 horas</small></div>
            <h3>Valida</h3>
            <p>Detecta errores, prueba supuestos y agrega control humano donde importa.</p>
          </li>
          <li>
            <div><span>04</span><small>16 horas</small></div>
            <h3>Activa</h3>
            <p>Presenta un proyecto aplicable y una ruta clara para seguir mejorándolo.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="ai-outcomes" aria-labelledby="ai-outcomes-title">
      <div class="ai-shell ai-outcomes__layout">
        <div class="ai-outcomes__copy" data-ai-reveal>
          <p class="ai-section-code">04 / CRITERIO + EJECUCIÓN</p>
          <h2 id="ai-outcomes-title">No solo usarás IA. Sabrás dirigirla.</h2>
          <p>
            La ventaja no está en aceptar la primera respuesta. Está en
            estructurar el problema, dar contexto, verificar y convertir la
            salida en una decisión o un proceso.
          </p>
          <a class="ai-text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            Hablar con el equipo <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ul class="ai-capability-grid" data-ai-reveal>
          <li>
            <span aria-hidden="true">⌁</span>
            <div><h3>Preguntar mejor</h3><p>Prompts con objetivo, contexto, restricciones y formato.</p></div>
          </li>
          <li>
            <span aria-hidden="true">◎</span>
            <div><h3>Validar siempre</h3><p>Criterios para revisar datos, supuestos, riesgos y calidad.</p></div>
          </li>
          <li>
            <span aria-hidden="true">↗</span>
            <div><h3>Diseñar sistemas</h3><p>Flujos repetibles que conectan herramientas, personas y decisiones.</p></div>
          </li>
          <li>
            <span aria-hidden="true">◇</span>
            <div><h3>Comunicar valor</h3><p>Resultados claros para clientes, equipos y líderes.</p></div>
          </li>
        </ul>
      </div>
    </section>

    <section class="ai-faq" id="preguntas" aria-labelledby="ai-faq-title">
      <div class="ai-shell ai-faq__layout">
        <div class="ai-faq__intro" data-ai-reveal>
          <p class="ai-section-code">05 / PREGUNTAS FRECUENTES</p>
          <h2 id="ai-faq-title">Antes de despegar.</h2>
          <p>
            Lo esencial para elegir tu taller y llegar preparado a la primera
            sesión.
          </p>
          <div class="ai-faq__status" aria-hidden="true">
            <span></span>
            Admisiones en línea
          </div>
        </div>
        <div class="ai-faq__items" data-ai-reveal>
          {
            faqs.map((faq, index) => (
              <details name="ai-academy-faq">
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {faq.question}
                  <i aria-hidden="true"></i>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ai-final-cta" aria-labelledby="ai-final-title">
      <div class="ai-final-cta__grid" aria-hidden="true"></div>
      <div class="ai-shell ai-final-cta__content" data-ai-reveal>
        <p class="ai-section-code">SEÑAL ABIERTA · CUPOS POR COHORTE</p>
        <h2 id="ai-final-title">¿Qué quieres hacer mejor con IA?</h2>
        <p>
          Escríbenos. Te ayudamos a elegir el taller según tu rol, tu reto y el
          proyecto que quieres construir.
        </p>
        <a class="ai-button ai-button--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Consultar fechas y cupos
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </div>
</LayoutNavbar>

<script>
  function initializeAiAcademy() {
    window.__aiAcademyCleanup?.();

    const track = document.querySelector<HTMLElement>("[data-ai-workshop-track]");
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-workshop-card]"),
    );
    const previous = document.querySelector<HTMLButtonElement>("[data-ai-track-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-ai-track-next]");
    const count = document.querySelector<HTMLElement>("[data-ai-track-count]");
    const progress = document.querySelector<HTMLElement>("[data-ai-track-progress]");
    const orbit = document.querySelector<HTMLElement>("[data-ai-orbit]");
    const revealItems = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-reveal]"),
    );
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;

    if (!track || cards.length === 0) return;

    let scrollFrame = 0;
    let activeIndex = 0;

    const updateTrackState = () => {
      scrollFrame = 0;
      const trackCenter = track.scrollLeft + track.clientWidth / 2;
      activeIndex = cards.reduce((closest, card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const currentCenter =
          cards[closest].offsetLeft + cards[closest].offsetWidth / 2;
        return Math.abs(cardCenter - trackCenter) <
          Math.abs(currentCenter - trackCenter)
          ? index
          : closest;
      }, 0);

      if (count) {
        count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
      }
      previous?.toggleAttribute("disabled", activeIndex === 0);
      next?.toggleAttribute("disabled", activeIndex === cards.length - 1);

      const maxScroll = Math.max(track.scrollWidth - track.clientWidth, 1);
      progress?.style.setProperty(
        "--ai-track-progress",
        String(Math.min(track.scrollLeft / maxScroll, 1)),
      );
    };

    const requestTrackUpdate = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateTrackState);
    };

    const goToCard = (index: number) => {
      const target = cards[Math.max(0, Math.min(index, cards.length - 1))];
      target?.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "nearest",
        inline: "center",
      });
    };

    const goPrevious = () => goToCard(activeIndex - 1);
    const goNext = () => goToCard(activeIndex + 1);
    const handleKeyboard = (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goPrevious();
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goNext();
      }
    };

    const handleOrbitPointer = (event: PointerEvent) => {
      if (!orbit) return;
      const bounds = orbit.getBoundingClientRect();
      orbit.style.setProperty("--orbit-pointer-x", `${event.clientX - bounds.left}px`);
      orbit.style.setProperty("--orbit-pointer-y", `${event.clientY - bounds.top}px`);
    };

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.aiVisible = "true";
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8%" },
    );

    revealItems.forEach((item) => {
      if (reduceMotion || item.getBoundingClientRect().top < window.innerHeight * 0.9) {
        item.dataset.aiVisible = "true";
      } else {
        revealObserver.observe(item);
      }
    });

    track.addEventListener("scroll", requestTrackUpdate, { passive: true });
    track.addEventListener("keydown", handleKeyboard);
    previous?.addEventListener("click", goPrevious);
    next?.addEventListener("click", goNext);
    if (finePointer) orbit?.addEventListener("pointermove", handleOrbitPointer);
    window.addEventListener("resize", requestTrackUpdate, { passive: true });
    updateTrackState();

    window.__aiAcademyCleanup = () => {
      revealObserver.disconnect();
      track.removeEventListener("scroll", requestTrackUpdate);
      track.removeEventListener("keydown", handleKeyboard);
      previous?.removeEventListener("click", goPrevious);
      next?.removeEventListener("click", goNext);
      orbit?.removeEventListener("pointermove", handleOrbitPointer);
      window.removeEventListener("resize", requestTrackUpdate);
      if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
    };
  }

