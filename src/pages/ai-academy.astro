    box-shadow: 0 0.9rem 2.5rem rgb(122 60 255 / 24%);
  }

  .ai-page {
    position: relative;
    overflow: clip;
    color: #fff;
    background:
      radial-gradient(circle at 10% 26%, rgb(44 103 186 / 15%), transparent 30rem),
      linear-gradient(180deg, rgb(0 0 81 / 30%), rgb(5 5 7 / 98%) 27%, #050507 100%);
  }

  .ai-shell {
    width: min(100% - 2.25rem, 1200px);
    margin-inline: auto;
  }

  .ai-hero {
    position: relative;
    display: grid;
    min-height: calc(100svh - 5.5rem);
    place-items: center;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 6.5rem) 0 5rem;
    isolation: isolate;
  }

  .ai-hero::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: "";
    background:
      radial-gradient(circle at 76% 44%, rgb(122 60 255 / 22%), transparent 27%),
      radial-gradient(circle at 72% 46%, rgb(44 103 186 / 26%), transparent 43%),
      linear-gradient(112deg, #000051 0%, #07052b 52%, #050507 100%);
  }

  .ai-hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 16rem;
    content: "";
    background: linear-gradient(transparent, #050507);
  }

  .ai-hero__grid,
  .ai-final-cta__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    background-image:
      linear-gradient(rgb(185 151 255 / 15%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(87 187 255 / 12%) 1px, transparent 1px);
    background-size: 74px 74px;
    mask-image: linear-gradient(90deg, #000 0%, #000 68%, transparent 96%);
  }

  .ai-hero__layout {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  .ai-hero__copy {
    position: relative;
    z-index: 2;
  }

  .ai-kicker,
  .ai-section-code {
    color: rgb(185 151 255 / 88%);
    font: 700 0.7rem/1.4 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }

  .ai-kicker span {
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ai-purple);
    box-shadow: 0 0 0 0.32rem rgb(122 60 255 / 13%), 0 0 1.15rem var(--ai-purple);
    animation: ai-signal 2.4s ease-out infinite;
  }

  .ai-hero h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3rem, 12vw, 6.8rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .ai-hero h1 span {
    display: block;
    margin-bottom: 0;
    padding-bottom: 0.18em;
    color: transparent;
    background: linear-gradient(110deg, #57bbff 2%, #dff5ff 38%, #b997ff 70%, #7a3cff);
    background-clip: text;
    line-height: 1.02;
  }

  .ai-hero__lead {
    max-width: 42rem;
    margin-top: 1.6rem;
    color: rgb(223 245 255 / 72%);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.75;
  }

  .ai-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .ai-button {
    display: inline-flex;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding: 0.85rem 1.35rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease, background 260ms ease;
  }

  .ai-button:hover {
    transform: translateY(-3px);
  }

  .ai-button--primary {
    color: #fff;
    background: linear-gradient(120deg, #6830e4, #8f58ff);
    box-shadow: 0 1rem 3rem rgb(122 60 255 / 28%), inset 0 1px rgb(255 255 255 / 20%);
  }

  .ai-button--primary:hover {
    box-shadow: 0 1.25rem 3.5rem rgb(122 60 255 / 42%), inset 0 1px rgb(255 255 255 / 28%);
  }

  .ai-button--ghost {
    color: rgb(223 245 255 / 86%);
    border-color: rgb(185 151 255 / 28%);
    background: rgb(7 16 43 / 42%);
    backdrop-filter: blur(12px);
  }

  .ai-button--ghost:hover {
    border-color: rgb(185 151 255 / 58%);
    background: rgb(122 60 255 / 12%);
  }

  .ai-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 31rem;
    margin-top: 2.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgb(185 151 255 / 18%);
  }

  .ai-metrics div {
    padding-right: 1rem;
  }

  .ai-metrics div + div {
    padding-left: 1rem;
    border-left: 1px solid rgb(185 151 255 / 18%);
  }

  .ai-metrics dt {
    color: var(--ai-ice);
    font: 800 clamp(1.4rem, 3vw, 2.15rem)/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-metrics dd {
    margin-top: 0.35rem;
    color: rgb(223 245 255 / 55%);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ai-metrics__workshops {
    position: relative;
    isolation: isolate;
  }

  .ai-metrics__workshops::after {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -0.7rem -0.8rem -0.55rem 0.45rem;
    border: 1px solid rgb(0 217 164 / 20%);
    border-radius: 0.8rem;
    background:
      linear-gradient(135deg, rgb(44 170 255 / 9%), rgb(0 217 164 / 5%)),
      rgb(7 16 43 / 22%);
    box-shadow: 0 0 24px rgb(0 170 128 / 7%);
  }

  .ai-metrics__workshops dt {
    color: #f4feff;
    text-shadow: 0 0 24px rgb(0 217 164 / 32%);
  }

  .ai-metrics__workshops dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    color: var(--ai-ice);
    font-weight: 800;
  }

  .ai-metrics__workshops dd strong {
    display: inline-flex;
    align-items: center;
    min-height: 1.25rem;
    padding: 0.18rem 0.45rem;
    border: 1px solid rgb(0 217 164 / 42%);
    border-radius: 999px;
    color: #7fffdc;
    background: rgb(0 170 128 / 13%);
    font-size: 0.54rem;
    letter-spacing: 0.13em;
    box-shadow: inset 0 0 14px rgb(0 217 164 / 8%);
    animation: ai-distinct-pulse 3.4s ease-in-out infinite;
  }

  .ai-metrics__note {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    max-width: 31rem;
    margin: 0.95rem 0 0;
    color: rgb(223 245 255 / 62%);
    font-size: 0.69rem;
    line-height: 1.55;
    letter-spacing: 0.015em;
  }

  .ai-metrics__note-icon {
    color: #7fffdc;
    font: 700 0.78rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-metrics__note strong {
    color: rgb(223 245 255 / 90%);
    font-weight: 700;
  }

  @keyframes ai-distinct-pulse {
    0%,
    100% {
      border-color: rgb(0 217 164 / 34%);
      box-shadow: inset 0 0 14px rgb(0 217 164 / 8%);
    }

    50% {
      border-color: rgb(127 255 220 / 70%);
      box-shadow:
        inset 0 0 14px rgb(0 217 164 / 16%),
        0 0 16px rgb(0 217 164 / 14%);
    }
  }

  .ai-orbit {
    --orbit-pointer-x: 68%;
    --orbit-pointer-y: 30%;
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 0.82;
    margin-inline: auto;
  }

  .ai-orbit::before {
    position: absolute;
    top: var(--orbit-pointer-y);
    left: var(--orbit-pointer-x);
    width: 12rem;
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background: radial-gradient(circle, rgb(185 151 255 / 24%), transparent 68%);
    filter: blur(8px);
    translate: -50% -50%;
    transition: top 700ms cubic-bezier(0.16, 1, 0.3, 1), left 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-orbit img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2rem 3.2rem rgb(0 0 0 / 48%));
    animation: ai-float 6s ease-in-out infinite;
  }

  .ai-orbit__halo {
    position: absolute;
    inset: 19% 8% 12%;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(122 60 255 / 24%), transparent 64%),
      radial-gradient(circle at 38% 56%, rgb(44 103 186 / 35%), transparent 52%);
    filter: blur(12px);
  }

  .ai-orbit__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgb(185 151 255 / 20%);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-16deg);
  }

  .ai-orbit__ring--outer {
    width: 102%;
    aspect-ratio: 1;
    border-style: dashed;
    animation: ai-ring 34s linear infinite;
  }

  .ai-orbit__ring--inner {
    width: 72%;
    aspect-ratio: 1;
    border-color: rgb(87 187 255 / 22%);
    animation: ai-ring 25s linear infinite reverse;
  }

  .ai-orbit__signal {
    position: absolute;
    z-index: 3;
    width: 0.58rem;
    aspect-ratio: 1;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--ai-purple);
    box-shadow: 0 0 1rem var(--ai-purple);
  }

  .ai-orbit__signal--one {
    top: 22%;
    right: 5%;
  }

  .ai-orbit__signal--two {
    bottom: 21%;
    left: 4%;
    animation-delay: -1.2s;
  }

  .ai-orbit figcaption {
    position: absolute;
    right: 0;
    bottom: 5%;
    z-index: 4;
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgb(185 151 255 / 24%);
    border-radius: 0.75rem;
    color: rgb(223 245 255 / 62%);
    background: rgb(5 5 7 / 66%);
    font: 600 0.64rem/1.4 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.04em;
    backdrop-filter: blur(14px);
  }

  .ai-orbit figcaption span {
    color: var(--ai-glow);
    font-weight: 800;
  }

  .ai-scroll-cue {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgb(223 245 255 / 46%);
    font: 700 0.62rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .ai-scroll-cue span {
    width: 1.9rem;
    height: 1px;
    overflow: hidden;
    background: rgb(185 151 255 / 26%);
  }

  .ai-scroll-cue span::after {
    display: block;
    width: 55%;
    height: 100%;
    content: "";
    background: var(--ai-glow);
    animation: ai-scroll-line 2s ease-in-out infinite;
  }

  .ai-manifesto,
  .ai-format,
  .ai-outcomes,
  .ai-faq {
    padding-block: clamp(5.5rem, 10vw, 9rem);
  }

  .ai-manifesto__layout {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgb(87 187 255 / 16%);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 82% 10%, rgb(122 60 255 / 12%), transparent 20rem),
      linear-gradient(135deg, rgb(0 0 81 / 42%), rgb(7 16 43 / 35%));
    box-shadow: inset 0 1px rgb(255 255 255 / 5%), 0 2rem 5rem rgb(0 0 0 / 18%);
  }

  .ai-manifesto h2,
  .ai-section-head h2,
  .ai-outcomes h2,
  .ai-faq h2,
  .ai-final-cta h2 {
    margin-top: 0.8rem;
    font-size: clamp(2.15rem, 6vw, 4.7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .ai-manifesto h2 span {
    color: var(--ai-glow);
  }

  .ai-manifesto h2 + p {
    max-width: 42rem;
    margin-top: 1.3rem;
    color: rgb(223 245 255 / 65%);
    line-height: 1.8;
  }

  .ai-manifesto__signal {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: rgb(223 245 255 / 58%);
    font: 700 0.65rem/1.4 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-manifesto__signal i {
    flex: 1;
    min-width: 1.4rem;
    height: 1px;
    background: linear-gradient(90deg, rgb(87 187 255 / 40%), var(--ai-purple));
  }

  .ai-manifesto__signal strong {
    color: var(--ai-glow);
  }

  [data-ai-reveal] {
    opacity: 0;
    transform: translateY(2.5rem);
    filter: blur(8px);
    transition: opacity 700ms ease, transform 900ms cubic-bezier(0.16, 1, 0.3, 1), filter 750ms ease;
  }

  [data-ai-reveal][data-ai-visible="true"] {
    opacity: 1;
    transform: none;
    filter: none;
  }

  .ai-workshops {
    padding-block: clamp(4rem, 9vw, 8rem);
    border-block: 1px solid rgb(185 151 255 / 11%);
    background:
      linear-gradient(90deg, transparent 0 49.9%, rgb(185 151 255 / 6%) 50%, transparent 50.1%),
      radial-gradient(circle at 50% 0%, rgb(122 60 255 / 12%), transparent 34rem);
  }

  .ai-section-head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .ai-section-head h2 {
    max-width: 13ch;
  }

  .ai-section-head__aside,
  .ai-section-head__copy {
    max-width: 31rem;
    color: rgb(223 245 255 / 58%);
    line-height: 1.7;
  }

  .ai-track-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .ai-track-controls button {
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0;
    place-items: center;
    border: 1px solid rgb(185 151 255 / 24%);
    border-radius: 50%;
    color: #fff;
    background: rgb(122 60 255 / 9%);
  }

  .ai-track-controls button:hover:not(:disabled) {
    border-color: var(--ai-glow);
    background: rgb(122 60 255 / 22%);
  }

  .ai-track-controls button:disabled {
    cursor: not-allowed;
    opacity: 0.28;
  }

  .ai-track-controls span {
    min-width: 4rem;
    text-align: center;
    color: var(--ai-glow);
    font: 700 0.72rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-workshop-track {
    display: grid;
    grid-auto-columns: min(1050px, calc(100vw - max(2.25rem, (100vw - 1200px) / 2)));
    grid-auto-flow: column;
    gap: 1.25rem;
    overflow-x: auto;
    padding: 0 max(1.125rem, calc((100vw - 1200px) / 2)) 2rem;
    scroll-padding-inline: max(1.125rem, calc((100vw - 1200px) / 2));
    scroll-snap-type: x mandatory;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
  }

  .ai-workshop-track::-webkit-scrollbar {
    display: none;
  }

  .ai-workshop-track:focus-visible {
    outline-offset: -4px;
  }

  .ai-workshop-card {
    position: relative;
    display: grid;
    min-height: 44rem;
    gap: 1.7rem;
    padding: clamp(1.35rem, 3vw, 2.5rem);
    overflow: hidden;
    scroll-snap-align: center;
    border: 1px solid rgb(185 151 255 / 18%);
    border-radius: 1.5rem;
    background:
      radial-gradient(circle at 96% 4%, rgb(122 60 255 / 18%), transparent 22rem),
      linear-gradient(135deg, rgb(8 13 57 / 94%), rgb(5 5 7 / 96%));
    box-shadow: inset 0 1px rgb(255 255 255 / 5%), 0 2rem 5rem rgb(0 0 0 / 26%);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-workshop-card--open {
    border-color: rgba(122, 60, 255, 0.48);
    background:
      radial-gradient(circle at 94% 6%, rgb(122 60 255 / 26%), transparent 24rem),
      radial-gradient(circle at 6% 94%, rgb(0 240 180 / 8%), transparent 20rem),
      linear-gradient(135deg, rgb(10 16 72 / 96%), rgb(5 5 8 / 98%));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 10%),
      0 0 35px rgb(122 60 255 / 20%),
      0 2rem 5rem rgb(0 0 0 / 32%);
  }

  .ai-workshop-card--open::before {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #2c67ba, var(--ai-purple), #7fffdc);
    content: "";
    z-index: 2;
  }

  .ai-workshop-card--upcoming {
    opacity: 0.94;
  }

  .ai-workshop-card::after {
    position: absolute;
    top: -32%;
    right: -11%;
    width: 24rem;
    aspect-ratio: 1;
    border: 1px dashed rgb(185 151 255 / 14%);
    border-radius: 50%;
    content: "";
  }

  .ai-workshop-card__top,
  .ai-workshop-card__intro,
  .ai-workshop-card__final {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .ai-workshop-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    color: rgb(185 151 255 / 72%);
    font: 700 0.65rem/1.2 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.12em;
  }

  .ai-workshop-card__top-lead {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .ai-workshop-card__code {
    margin: 0;
    color: rgb(185 151 255 / 90%);
    font-weight: 800;
  }

  .ai-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font: 700 0.62rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: all 0.25s ease;
  }

  .ai-status-pill--open {
    background: rgba(0, 240, 180, 0.12);
    border: 1px solid rgba(0, 240, 180, 0.38);
    color: #7fffdc;
    box-shadow: 0 0 12px rgba(0, 240, 180, 0.15);
  }

  .ai-status-pill--upcoming {
    background: rgba(185, 151, 255, 0.1);
    border: 1px solid rgba(185, 151, 255, 0.22);
    color: #d6c6ff;
  }

  .ai-status-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    display: inline-block;
  }

  .ai-status-pill--open .ai-status-pill__dot {
    background: #00f0b4;
    box-shadow: 0 0 8px #00f0b4;
    animation: ai-pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes ai-pulse-dot {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.55; }
  }

  .ai-workshop-card__top-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .ai-workshop-card__date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.65rem;
    border-radius: 0.5rem;
    background: rgba(44, 103, 186, 0.2);
    border: 1px solid rgba(87, 187, 255, 0.35);
    color: #dff5ff;
    font: 600 0.64rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.04em;
  }

  .ai-icon-cal {
    color: #7fffdc;
    flex-shrink: 0;
  }

  .ai-date-label {
    color: #7fffdc;
    font-weight: 700;
  }

  .ai-workshop-card__format-tag {
    color: rgb(223 245 255 / 46%);
    font: 600 0.62rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
  }

  .ai-workshop-card__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(17rem, 0.6fr);
    align-items: end;
  }

  .ai-workshop-card__intro > div {
    display: flex;
    align-items: flex-end;
    gap: 0.8rem;
  }

  .ai-workshop-card__number {
    color: transparent;
    font: 800 clamp(3rem, 8vw, 6rem)/0.82 Menlo, Monaco, Consolas, monospace;
    -webkit-text-stroke: 1px rgb(185 151 255 / 25%);
  }

  .ai-workshop-card__eyebrow {
    display: block;
    margin-bottom: 0.35rem;
    color: var(--ai-glow);
    font: 700 0.72rem/1.2 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ai-workshop-card h3 {
    max-width: 14ch;
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: -0.05em;
  }

  .ai-workshop-card__intro > p {
    max-width: 28rem;
    color: rgb(223 245 255 / 67%);
    line-height: 1.7;
  }

  .ai-workshop-card__meta {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    padding-block: 1.2rem;
    border-block: 1px solid rgb(185 151 255 / 12%);
  }

  .ai-workshop-card__meta p {
    color: rgb(223 245 255 / 65%);
    font-size: 0.84rem;
  }

  .ai-workshop-card__meta p span,
  .ai-workshop-card__final p span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--ai-glow);
    font: 700 0.6rem/1.2 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ai-workshop-card__meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .ai-workshop-card__meta li {
    padding: 0.38rem 0.7rem;
    border: 1px solid rgb(87 187 255 / 20%);
    border-radius: 999px;
    color: rgb(223 245 255 / 65%);
    background: rgb(44 103 186 / 10%);
    font-size: 0.68rem;
  }

  .ai-session-grid {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.75rem;
  }

  .ai-session-grid li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 0.8rem;
    padding: 1rem;
    border: 1px solid rgb(255 255 255 / 7%);
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 2.5%);
  }

  .ai-session-grid__index {
    grid-row: 1 / 4;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    color: var(--ai-glow);
    font: 700 0.65rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-session-grid__index i {
    width: 1px;
    flex: 1;
    background: linear-gradient(var(--ai-purple), transparent);
  }

  .ai-session-grid h4 {
    font-size: 0.98rem;
    font-weight: 700;
  }

  .ai-session-grid p {
    margin-top: 0.3rem;
    color: rgb(223 245 255 / 53%);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .ai-session-grid strong {
    margin-top: 0.55rem;
    color: rgb(87 187 255 / 86%);
    font: 700 0.63rem/1.3 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.04em;
  }

  .ai-workshop-card__final {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .ai-workshop-card__final p {
    max-width: 33rem;
    color: rgb(223 245 255 / 66%);
    font-size: 0.83rem;
    line-height: 1.6;
    margin: 0;
  }

  .ai-workshop-card__actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .ai-btn-curriculum {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.75rem;
    background: rgba(185, 151, 255, 0.08);
    border: 1px solid rgba(185, 151, 255, 0.3);
    color: #e5d9ff;
    font: 700 0.74rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 0.22s ease;
  }

  .ai-btn-curriculum:hover {
    background: rgba(122, 60, 255, 0.22);
    border-color: rgba(185, 151, 255, 0.65);
    color: #ffffff;
    box-shadow: 0 0 15px rgba(122, 60, 255, 0.35);
    transform: translateY(-1px);
  }

  .ai-btn-curriculum .ai-icon-doc {
    color: var(--ai-glow);
    flex-shrink: 0;
  }

  .ai-workshop-card__cta,
  .ai-workshop-card__final a,
  .ai-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgb(185 151 255 / 45%);
    color: var(--ai-glow);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ai-workshop-card__cta:hover,
  .ai-workshop-card__final a:hover,
  .ai-text-link:hover {
    color: #ffffff;
    border-bottom-color: #7fffdc;
    transform: translateX(2px);
  }

  /* Modal de Malla Curricular */
  body.ai-modal-open {
    overflow: hidden;
  }

  .ai-modal {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .ai-modal--active {
    opacity: 1;
    pointer-events: auto;
  }

  .ai-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(3, 4, 15, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .ai-modal__dialog {
    position: relative;
    z-index: 2;
    width: min(100%, 780px);
    max-height: calc(100vh - 2.5rem);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    border-radius: 1.5rem;
    border: 1px solid rgba(185, 151, 255, 0.28);
    background:
      radial-gradient(circle at 90% 10%, rgba(122, 60, 255, 0.22), transparent 28rem),
      linear-gradient(145deg, #090e38 0%, #05050e 100%);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.65), 0 0 45px rgba(122, 60, 255, 0.2);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    transform: translateY(18px) scale(0.97);
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-modal--active .ai-modal__dialog {
    transform: translateY(0) scale(1);
  }

  .ai-modal__top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .ai-modal__badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .ai-modal__badge {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: rgba(122, 60, 255, 0.25);
    border: 1px solid rgba(185, 151, 255, 0.4);
    color: var(--ai-glow);
    font: 800 0.62rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
  }

  .ai-modal__code {
    color: #7fffdc;
    font: 800 0.68rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-modal__close-btn {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1px solid rgba(185, 151, 255, 0.25);
    background: rgba(185, 151, 255, 0.08);
    color: #dff5ff;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .ai-modal__close-btn:hover {
    background: rgba(185, 151, 255, 0.25);
    color: #ffffff;
    transform: rotate(90deg);
  }

  .ai-modal__title {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 800;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 0.45rem;
  }

  .ai-modal__subtitle {
    color: rgb(223 245 255 / 75%);
    font-size: 0.92rem;
    line-height: 1.5;
    margin: 0;
  }

  .ai-modal__meta-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    margin-top: 1.35rem;
    padding: 1rem;
    border-radius: 1rem;
    background: rgba(0, 0, 81, 0.35);
    border: 1px solid rgba(185, 151, 255, 0.15);
  }

  .ai-modal__meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .ai-modal__meta-label {
    color: rgb(185 151 255 / 65%);
    font: 700 0.58rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
  }

  .ai-modal__meta-value {
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .ai-modal__body {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .ai-modal__body-heading {
    color: var(--ai-glow);
    font: 700 0.74rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
  }

  .ai-modal__sessions-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .ai-modal-session-card {
    padding: 1rem;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(185, 151, 255, 0.12);
  }

  .ai-modal-session-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
  }

  .ai-modal-session-card__tag {
    color: var(--ai-glow);
    font: 800 0.62rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-modal-session-card__output {
    color: #7fffdc;
    font: 700 0.64rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-modal-session-card__title {
    margin: 0 0 0.35rem;
    font-size: 0.96rem;
    font-weight: 700;
    color: #ffffff;
  }

  .ai-modal-session-card__desc {
    margin: 0;
    color: rgb(223 245 255 / 68%);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .ai-modal__deliverable {
    padding: 1rem;
    border-radius: 0.85rem;
    background: rgba(122, 60, 255, 0.12);
    border: 1px solid rgba(185, 151, 255, 0.28);
  }

  .ai-modal__deliverable-badge {
    display: block;
    color: #7fffdc;
    font: 800 0.6rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .ai-modal__deliverable p {
    margin: 0;
    color: #ffffff;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .ai-modal__footer {
    margin-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(185, 151, 255, 0.15);
  }

  .ai-modal__btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.15rem;
    border-radius: 0.75rem;
    background: rgba(44, 103, 186, 0.2);
    border: 1px solid rgba(87, 187, 255, 0.4);
    color: #dff5ff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .ai-modal__btn-secondary:hover {
    background: rgba(44, 103, 186, 0.4);
    border-color: #7fffdc;
    color: #ffffff;
  }

  .ai-modal__btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.75rem 1.35rem;
    border-radius: 0.75rem;
    background: linear-gradient(135deg, var(--ai-purple), #965fff);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 18px rgba(122, 60, 255, 0.45);
    transition: all 0.2s ease;
  }

  .ai-modal__btn-primary:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
    box-shadow: 0 6px 22px rgba(122, 60, 255, 0.6);
  }

  .ai-track-progress {
    width: min(calc(100% - 2.25rem), 1200px);
    height: 2px;
    margin: 0 auto;
    overflow: hidden;
    background: rgb(185 151 255 / 12%);
  }

  .ai-track-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #2c67ba, var(--ai-purple), var(--ai-glow));
    box-shadow: 0 0 1rem rgb(122 60 255 / 80%);
    transform: scaleX(var(--ai-track-progress, 0));
    transform-origin: left;
  }

  .ai-format {
    background: linear-gradient(180deg, rgb(0 0 81 / 12%), transparent);
  }

  .ai-timeline {
    display: grid;
    margin-top: 3rem;
    border-top: 1px solid rgb(185 151 255 / 16%);
  }

  .ai-timeline li {
    position: relative;
    padding: 1.5rem 0 1.5rem 2rem;
    border-bottom: 1px solid rgb(185 151 255 / 12%);
  }

  .ai-timeline li::before {
    position: absolute;
    top: 2rem;
    left: -0.28rem;
    width: 0.55rem;
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background: var(--ai-purple);
    box-shadow: 0 0 1rem var(--ai-purple);
  }

  .ai-timeline li > div {
    display: flex;
    justify-content: space-between;
    color: var(--ai-glow);
    font: 700 0.68rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-timeline small {
    color: rgb(223 245 255 / 38%);
  }

  .ai-timeline h3 {
    margin-top: 1.5rem;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
  }

  .ai-timeline p {
    margin-top: 0.55rem;
    color: rgb(223 245 255 / 53%);
    font-size: 0.86rem;
    line-height: 1.65;
  }

  .ai-outcomes {
    border-block: 1px solid rgb(185 151 255 / 10%);
    background:
      radial-gradient(circle at 12% 48%, rgb(44 103 186 / 18%), transparent 27rem),
      radial-gradient(circle at 88% 52%, rgb(122 60 255 / 12%), transparent 28rem);
  }

  .ai-outcomes__layout {
    display: grid;
    gap: 3rem;
  }

  .ai-outcomes__copy > p:not(.ai-section-code) {
    max-width: 35rem;
    margin: 1.3rem 0 1.6rem;
    color: rgb(223 245 255 / 58%);
    line-height: 1.75;
  }

  .ai-capability-grid {
    display: grid;
    gap: 0.8rem;
  }

  .ai-capability-grid li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1rem;
    padding: 1.15rem;
    border: 1px solid rgb(185 151 255 / 13%);
    border-radius: 1rem;
    background: rgb(7 16 43 / 42%);
  }

  .ai-capability-grid li > span {
    display: grid;
    width: 3rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(185 151 255 / 24%);
    border-radius: 0.8rem;
    color: var(--ai-glow);
    background: rgb(122 60 255 / 10%);
    font-size: 1.25rem;
  }

  .ai-capability-grid h3 {
    font-size: 1rem;
    font-weight: 700;
  }

  .ai-capability-grid p {
    margin-top: 0.3rem;
    color: rgb(223 245 255 / 50%);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .ai-faq__layout {
    display: grid;
    gap: 3rem;
    align-items: start;
  }

  .ai-faq__intro {
    position: sticky;
    top: 8rem;
  }

  .ai-faq__intro > p:not(.ai-section-code) {
    max-width: 28rem;
    margin-top: 1rem;
    color: rgb(223 245 255 / 55%);
    line-height: 1.7;
  }

  .ai-faq__status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    color: rgb(223 245 255 / 47%);
    font: 700 0.65rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ai-faq__status span {
    width: 0.48rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #39e3b3;
    box-shadow: 0 0 0.8rem #39e3b3;
  }

  .ai-faq__items {
    border-top: 1px solid rgb(185 151 255 / 16%);
  }

  .ai-faq details {
    border-bottom: 1px solid rgb(185 151 255 / 14%);
  }

  .ai-faq summary {
    display: grid;
    grid-template-columns: 2.25rem 1fr 1.4rem;
    gap: 0.8rem;
    align-items: center;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 0.93rem;
    font-weight: 600;
  }

  .ai-faq summary::-webkit-details-marker {
    display: none;
  }

  .ai-faq summary > span {
    color: var(--ai-glow);
    font: 700 0.65rem/1 Menlo, Monaco, Consolas, monospace;
  }

  .ai-faq summary i {
    position: relative;
    width: 1.15rem;
    height: 1.15rem;
  }

  .ai-faq summary i::before,
  .ai-faq summary i::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 1px;
    content: "";
    background: var(--ai-glow);
    transform: translate(-50%, -50%);
    transition: transform 260ms ease;
  }

  .ai-faq summary i::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .ai-faq details[open] summary i::after {
    transform: translate(-50%, -50%) rotate(0);
  }

  .ai-faq details > p {
    max-width: 44rem;
    padding: 0 2rem 1.35rem 3.05rem;
    color: rgb(223 245 255 / 56%);
    font-size: 0.86rem;
    line-height: 1.75;
  }

  .ai-final-cta {
    position: relative;
    min-height: 34rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-top: 1px solid rgb(185 151 255 / 14%);
    background:
      radial-gradient(circle at 50% 42%, rgb(122 60 255 / 24%), transparent 24rem),
      linear-gradient(140deg, #000051, #0c053a 48%, #050507);
    isolation: isolate;
  }

  .ai-final-cta__grid {
    opacity: 0.24;
    mask-image: radial-gradient(circle at 50% 50%, #000, transparent 72%);
  }

  .ai-final-cta__content {
    padding-block: 6rem;
    text-align: center;
  }

  .ai-final-cta h2 {
    max-width: 15ch;
    margin-inline: auto;
  }

  .ai-final-cta__content > p:not(.ai-section-code) {
    max-width: 38rem;
    margin: 1.4rem auto 2rem;
    color: rgb(223 245 255 / 62%);
    line-height: 1.75;
  }

  @keyframes ai-signal {
    65%, 100% { box-shadow: 0 0 0 0.8rem transparent, 0 0 1.15rem var(--ai-purple); }
  }

  @keyframes ai-float {
    0%, 100% { transform: translateY(0) rotate(-0.6deg); }
    50% { transform: translateY(-0.8rem) rotate(0.6deg); }
  }

  @keyframes ai-ring {
    to { transform: translate(-50%, -50%) rotate(344deg); }
  }

  @keyframes ai-scroll-line {
    0% { transform: translateX(-110%); }
    100% { transform: translateX(290%); }
  }

  @media (min-width: 720px) {
    .ai-shell {
      width: min(100% - 4rem, 1200px);
    }

    .ai-hero__layout {
      grid-template-columns: minmax(0, 1.05fr) minmax(21rem, 0.95fr);
    }

    .ai-section-head {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.55fr);
    }

    .ai-workshop-track {
      padding-inline: max(2rem, calc((100vw - 1200px) / 2));
      scroll-padding-inline: max(2rem, calc((100vw - 1200px) / 2));
    }

    .ai-workshop-card__meta {
      grid-template-columns: 1fr auto;
      align-items: center;
    }

    .ai-session-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-timeline {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-bottom: 1px solid rgb(185 151 255 / 16%);
    }

    .ai-timeline li {
      padding: 2rem 1.5rem;
      border-bottom: 0;
    }

    .ai-timeline li + li {
      border-left: 1px solid rgb(185 151 255 / 12%);
    }

    .ai-timeline li::before {
      top: -0.3rem;
      left: 1.5rem;
    }

    .ai-outcomes__layout,
    .ai-faq__layout {
      grid-template-columns: minmax(0, 0.8fr) minmax(24rem, 1.2fr);
    }

    .ai-capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .ai-manifesto__layout {
      grid-template-columns: 0.35fr 1.25fr 0.7fr;
    }

    .ai-session-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .ai-hero {
      padding-top: 3rem;
    }

    .ai-orbit {
      order: -1;
      width: min(64vw, 14.5rem);
      margin-top: -1.25rem;
      margin-bottom: -1rem;
    }

    .ai-orbit figcaption {
      right: 0.5rem;
      bottom: 7%;
    }

    .ai-scroll-cue {
      display: none;
    }

    .ai-metrics__workshops::after {
      inset: -0.55rem -0.35rem -0.5rem 0.35rem;
    }

    .ai-metrics__workshops dd {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }

    .ai-metrics__note {
      align-items: flex-start;
    }

    .ai-workshop-track {
      grid-auto-columns: calc(100vw - 2.25rem);
    }

    .ai-workshop-card {
      min-height: auto;
    }

    .ai-workshop-card__intro,
    .ai-workshop-card__final {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .ai-workshop-card__intro > div {
      display: block;
    }

    .ai-workshop-card__number {
      display: block;
      margin-bottom: 0.8rem;
    }

    .ai-workshop-card__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .ai-workshop-card__top-lead,
    .ai-workshop-card__top-meta {
      width: 100%;
      justify-content: space-between;
    }

    .ai-workshop-card__actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .ai-btn-curriculum,
    .ai-workshop-card__cta {
      justify-content: center;
      text-align: center;
      width: 100%;
    }

    .ai-modal__footer {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-modal__btn-secondary,
    .ai-modal__btn-primary {
      justify-content: center;
      text-align: center;
      width: 100%;
    }

    .ai-timeline {
      margin-left: 0.3rem;
      border-top: 0;
      border-left: 1px solid rgb(185 151 255 / 16%);
    }

    .ai-faq__intro {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-kicker span,
    .ai-orbit img,
    .ai-orbit__ring,
    .ai-scroll-cue span::after,
    .ai-metrics__workshops dd strong {
      animation: none;
    }

    [data-ai-reveal] {
      opacity: 1;
      transform: none;
