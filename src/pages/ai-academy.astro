<script>
  function initializeAiAcademy() {
    window.__aiAcademyCleanup?.();

    const track = document.querySelector<HTMLElement>("[data-ai-workshop-track]");
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-workshop-card]"),
    );
    const previous = document.querySelector<HTMLButtonElement>("[data-ai-track-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-ai-track-next]");
    const count = document.querySelector<HTMLElement>("[data-ai-track-count]");
    const progress = document.querySelector<HTMLElement>("[data-ai-track-progress]");
    const orbit = document.querySelector<HTMLElement>("[data-ai-orbit]");
    const revealItems = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-reveal]"),
    );
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;

    if (!track || cards.length === 0) return;

    let scrollFrame = 0;
    let activeIndex = 0;

    const updateTrackState = () => {
      scrollFrame = 0;
      const trackCenter = track.scrollLeft + track.clientWidth / 2;
      activeIndex = cards.reduce((closest, card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const currentCenter =
          cards[closest].offsetLeft + cards[closest].offsetWidth / 2;
        return Math.abs(cardCenter - trackCenter) <
          Math.abs(currentCenter - trackCenter)
          ? index
          : closest;
      }, 0);

      if (count) {
        count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
      }
      previous?.toggleAttribute("disabled", activeIndex === 0);
      next?.toggleAttribute("disabled", activeIndex === cards.length - 1);

      const maxScroll = Math.max(track.scrollWidth - track.clientWidth, 1);
      progress?.style.setProperty(
        "--ai-track-progress",
        String(Math.min(track.scrollLeft / maxScroll, 1)),
      );
    };

    const requestTrackUpdate = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateTrackState);
    };

    const goToCard = (index: number) => {
      const target = cards[Math.max(0, Math.min(index, cards.length - 1))];
      target?.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "nearest",
        inline: "center",
      });
    };

    const goPrevious = () => goToCard(activeIndex - 1);
    const goNext = () => goToCard(activeIndex + 1);
    const handleKeyboard = (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goPrevious();
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goNext();
      }
    };

    const handleOrbitPointer = (event: PointerEvent) => {
      if (!orbit) return;
      const bounds = orbit.getBoundingClientRect();
      orbit.style.setProperty("--orbit-pointer-x", `${event.clientX - bounds.left}px`);
      orbit.style.setProperty("--orbit-pointer-y", `${event.clientY - bounds.top}px`);
    };

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.aiVisible = "true";
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8%" },
    );

    revealItems.forEach((item) => {
      if (reduceMotion || item.getBoundingClientRect().top < window.innerHeight * 0.9) {
        item.dataset.aiVisible = "true";
      } else {
        revealObserver.observe(item);
      }
    });

    track.addEventListener("scroll", requestTrackUpdate, { passive: true });
    track.addEventListener("keydown", handleKeyboard);
    previous?.addEventListener("click", goPrevious);
    next?.addEventListener("click", goNext);
    if (finePointer) orbit?.addEventListener("pointermove", handleOrbitPointer);
    window.addEventListener("resize", requestTrackUpdate, { passive: true });
    updateTrackState();

    // Modal de Malla Curricular
    const modal = document.getElementById("ai-curriculum-modal");
    const modalCode = document.getElementById("ai-modal-code");
    const modalTitle = document.getElementById("ai-modal-title");
    const modalPromise = document.getElementById("ai-modal-promise");
    const modalSessions = document.getElementById("ai-modal-sessions");
    const modalFinal = document.getElementById("ai-modal-final");
    const modalPdfBtn = document.getElementById("ai-modal-pdf-btn") as HTMLAnchorElement | null;
    const modalWaBtn = document.getElementById("ai-modal-whatsapp-btn") as HTMLAnchorElement | null;
    const modalStatusPill = document.getElementById("ai-modal-status-pill");
    const modalStatusText = document.getElementById("ai-modal-status-text");

    let workshopsData: any[] = [];
    try {
      const payloadEl = document.getElementById("ai-workshops-payload");
      if (payloadEl && payloadEl.textContent) {
        workshopsData = JSON.parse(payloadEl.textContent);
      }
    } catch (e) {
      console.warn("Error leyendo ai-workshops-payload", e);
    }

    const openModal = (workshopId: string) => {
      if (!modal) return;
      const workshop = workshopsData.find((w) => w.id === workshopId);
      if (!workshop) return;

      if (modalCode) modalCode.textContent = workshop.code || "IA";
      if (modalTitle) modalTitle.textContent = workshop.fullName || workshop.title || "Taller";
      if (modalPromise) modalPromise.textContent = workshop.promise || "";
      if (modalFinal) modalFinal.textContent = workshop.final || "";

      if (modalStatusPill && modalStatusText) {
        if (workshop.isOpen) {
          modalStatusPill.className = "ai-status-pill ai-status-pill--open";
          modalStatusText.textContent = workshop.startDate ? `Inicia: ${workshop.startDate} · Inscripciones abiertas` : "Inscripciones abiertas";
        } else {
          modalStatusPill.className = "ai-status-pill ai-status-pill--upcoming";
          modalStatusText.textContent = workshop.startDate && workshop.startDate !== "Próximamente" ? `Inicio estimado: ${workshop.startDate}` : "Próximamente";
        }
      }

      if (modalSessions) {
        modalSessions.innerHTML = "";
        (workshop.sessions || []).forEach((session: any, idx: number) => {
          const li = document.createElement("li");
          li.className = "ai-modal-session-card";
          li.innerHTML = `
            <div class="ai-modal-session-card__head">
              <span class="ai-modal-session-card__tag">SESIÓN 0${idx + 1}</span>
              <strong class="ai-modal-session-card__output">${session.output || ""}</strong>
            </div>
            <h5 class="ai-modal-session-card__title">${session.title}</h5>
            <p class="ai-modal-session-card__desc">${session.description}</p>
          `;
          modalSessions.appendChild(li);
        });
      }

      if (modalPdfBtn) {
        if (workshop.curriculumUrl) {
          modalPdfBtn.href = workshop.curriculumUrl;
          modalPdfBtn.style.display = "inline-flex";
        } else {
          modalPdfBtn.style.display = "none";
        }
      }

      if (modalWaBtn) {
        const text = workshop.id === "ia-cero-agentes"
          ? "¡Hola! Escribo IA para recibir la información de inscripción, fechas y consultar las opciones de pago con tarjeta para el Taller Práctico: IA de cero a Agentes de Campuslands Guatemala."
          : `¡Hola! Me interesa la malla curricular y fechas del taller "${workshop.title}" de AI Academy en Campuslands Guatemala.`;
        modalWaBtn.href = `https://wa.me/50232705200?text=${encodeURIComponent(text)}`;
      }

      modal.classList.add("ai-modal--active");
      modal.setAttribute("aria-hidden", "false");
      document.body.classList.add("ai-modal-open");
    };

    const closeModal = () => {
      if (!modal) return;
      modal.classList.remove("ai-modal--active");
      modal.setAttribute("aria-hidden", "true");
      document.body.classList.remove("ai-modal-open");
    };

    const curriculumTriggers = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-ai-curriculum-trigger]")
    );
    curriculumTriggers.forEach((btn) => {
      btn.addEventListener("click", () => {
        const workshopId = btn.getAttribute("data-workshop-id");
        if (workshopId) openModal(workshopId);
      });
    });

    const closeButtons = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-modal-close]")
    );
    closeButtons.forEach((btn) => {
      btn.addEventListener("click", closeModal);
    });

    const handleModalKeydown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && modal?.classList.contains("ai-modal--active")) {
        closeModal();
      }
    };
    window.addEventListener("keydown", handleModalKeydown);

    // Sincronización dinámica reactiva silenciosa
    fetch("/api/ai-academy/config")
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (!data || !data.workshops) return;
        Object.entries(data.workshops).forEach(([id, cfg]: [string, any]) => {
          const card = document.getElementById(id);
          const memoryItem = workshopsData.find((w) => w.id === id);
          if (memoryItem) {
            memoryItem.isOpen = Boolean(cfg.isOpen);
            if (cfg.startDate) memoryItem.startDate = cfg.startDate;
            if (cfg.curriculumUrl !== undefined) memoryItem.curriculumUrl = cfg.curriculumUrl;
          }

          if (!card) return;
          const isOpen = Boolean(cfg.isOpen);
          card.classList.toggle("ai-workshop-card--open", isOpen);
          card.classList.toggle("ai-workshop-card--upcoming", !isOpen);
          card.setAttribute("data-workshop-open", isOpen ? "true" : "false");

          const statusPill = card.querySelector<HTMLElement>("[data-status-pill]");
          const statusText = card.querySelector<HTMLElement>("[data-status-text]");
          if (statusPill && statusText) {
            statusPill.className = `ai-status-pill ${isOpen ? "ai-status-pill--open" : "ai-status-pill--upcoming"}`;
            statusText.textContent = isOpen ? "Inscripciones abiertas" : "Próximamente";
          }

          const datePill = card.querySelector<HTMLElement>("[data-date-pill]");
          const dateText = card.querySelector<HTMLElement>("[data-date-text]");
          if (cfg.startDate && dateText) {
            dateText.textContent = cfg.startDate;
            if (datePill) datePill.style.display = "inline-flex";
          }

          const currBtn = card.querySelector<HTMLButtonElement>("[data-ai-curriculum-trigger]");
          if (currBtn && cfg.curriculumUrl !== undefined) {
            currBtn.setAttribute("data-curriculum-url", cfg.curriculumUrl);
          }

          const ctaLink = card.querySelector<HTMLAnchorElement>(".ai-workshop-card__cta span:first-child");
          if (ctaLink) {
            ctaLink.textContent = isOpen ? "Inscribirme al taller" : "Consultar este taller";
          }
        });
      })
      .catch(() => {});

    window.__aiAcademyCleanup = () => {
      revealObserver.disconnect();
      track.removeEventListener("scroll", requestTrackUpdate);
      track.removeEventListener("keydown", handleKeyboard);
      previous?.removeEventListener("click", goPrevious);
      next?.removeEventListener("click", goNext);
      orbit?.removeEventListener("pointermove", handleOrbitPointer);
      window.removeEventListener("resize", requestTrackUpdate);
      window.removeEventListener("keydown", handleModalKeydown);
      closeButtons.forEach((btn) => btn.removeEventListener("click", closeModal));
      document.body.classList.remove("ai-modal-open");
      if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
    };
  }

  document.addEventListener("astro:page-load", initializeAiAcademy);
  document.addEventListener("astro:before-swap", () => {
    window.__aiAcademyCleanup?.();
  });
</script>

