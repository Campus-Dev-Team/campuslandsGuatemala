---
import LayoutNavbar from "../layouts/LayoutNavbar.astro";
import Intro from "../components/patrocinar/intro.astro";
import Items from "../components/patrocinar/items.astro";
import Donate from "../components/patrocinar/donate.astro";
import Subscribe from "../components/patrocinar/subscribe.astro";
import AlliedCompanies from "../components/patrocinar/alliedCompanies.astro";
import "~/styles/index.css";

const dataFooter = {
  title: "¿Listo para transformar vidas a través de la tecnología?",
  content:
    "Sé parte del cambio que impulsa el talento tech en Latinoamérica. Tu apoyo abre las puertas a jóvenes con potencial para desarrollarse en la industria tecnológica. ¡Únete como patrocinador y construye un futuro más inclusivo!",
  buttonType: "patrocinio",
  buttonIcon: "heartdark.svg",
};
---

<LayoutNavbar
  dataFooter={dataFooter}
  structuredData={{
    "@type": "Service",
    "@id": "https://www.campuslands.pro/patrocina/#servicio",
    name: "Patrocinio de formación tecnológica para jóvenes en Guatemala",
    description:
      "Programa de patrocinio para impulsar la formación tecnológica y profesional de jóvenes guatemaltecos.",
    url: "https://www.campuslands.pro/patrocina/",
    provider: { "@id": "https://www.campuslands.pro/#organization" },
    areaServed: { "@type": "Country", name: "Guatemala" },
    serviceType: "Patrocinio educativo",
  }}
>
  <Intro />
  <div class="sections max-w-[1150px] self-center">
    <picture>
      <source media="(max-width: 639px)" srcset="/img/patrocina/cardMobile.png" />
      <img
        src="/img/patrocina/card.png"
        alt="Campers de Campuslands Guatemala con un mensaje sobre patrocinio de talento joven"
        class="w-full"
        width="1135"
        height="285"
        loading="lazy"
        decoding="async"
      />
    </picture>
  </div>
  <Items />
  <Donate />
  <Subscribe />
  <AlliedCompanies />
</LayoutNavbar>

<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    color: white;
    font-size: 20px;
    line-height: 1.6;
  }
</style>
